  "on": [
    {
      "event": "issue.labeled:todo",
      "flow": "issue/poc",
      "description": "Build a failing test and PoC for every maintainer-accepted TODO"
    },
    {
      "event": "change.opened",
      "flow": "checks/review",
      "description": "Review every Change through Voltaire's quality, crypto safety, and trust lenses"
    },
    {
      "event": "change.updated",
      "flow": "checks/review",
      "description": "Re-review every updated Change"
    },
    {
      "event": "change.landed",
      "flow": [
        "docs-publish",
        "release"
      ],
      "description": "Verify docs, refresh wiki feeds, and rehearse releases after every landing"
    },
    {
      "event": "github.push:main",
      "flow": [
        "ci",
        "docs-publish"
      ],
      "description": "Run full CI and refresh docs, playground, and wiki feeds on main pushes"
    },
    {
      "event": "schedule:0 2 * * *",
      "flow": "security-audit",
      "description": "Audit cryptography, FFI ownership, and cache trust boundaries nightly"
    },
    {
      "event": "schedule:0 10 * * 1",
      "flow": "ci-health",
      "description": "Report build graph cache health, WASM bundle deltas, and Lighthouse score trends weekly"
    }
  ],
  "github": {
    "mirror": "push",
    "issues": "two-way",
    "changes": "land",
    "protectedPaths": [
      ".smithers/WORKSPACE.ts",
      ".smithers/FACTORY.ts",
      ".smithers/HOME.ts",
      ".smithers/PACKAGE.ts",
      ".smithers/factory.json",
      ".smithers/home.json",
      ".smithers/package.json",
      ".agents/uphill",
      ".github",
      ".mcp.json",
      "build.zig",
      "build.zig.zon",
      "Cargo.toml",
      "Cargo.lock",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "scripts/smthrs",
      "scripts/smthrs-auth.mjs",
      "scripts/publish-npm.mjs",
      "scripts/verify-packaging.mjs",
      "scripts/audit-report.mjs",
      "scripts/publish-feeds.mjs",
      "packages/voltaire-zig/src/crypto",
      "packages/voltaire-zig/src/c_api.zig",
      "packages/voltaire-zig/src/primitives.h"
    ],
    "maintainers": [
      "roninjin10"
    ],
    "dailyTokens": 1000000000
  },
  "policy": {
    "lifecycle": {
      "docs": "evergreen",
      "tests": "evergreen"
    },
    "notifications": {
      "quietHours": []
    },
    "approvals": {
      "approve": "person",
      "merge": "person"
    }
  },
  "machine": {
    "vcpus": 8,
    "memoryMiB": 16384,
    "tools": [
      "zig",
      "cargo",
      "rustc",
      "cc",
      "node",
      "pnpm",
      "bun",
      "uphill"
    ]
  },
  "issueViews": [
    {
      "id": "open",
      "title": "All Open Issues",
      "state": "open"
    },
    {
      "id": "todos",
      "title": "Accepted TODOs",
      "state": "open",
      "labels": [
        "todo"
      ]
    },
    {
      "id": "bugs",
      "title": "Bugs",
      "state": "open",
      "labels": [
        "bug"
      ]
    },
    {
      "id": "zig",
      "title": "Zig Core",
      "state": "open",
      "labels": [
        "zig"
      ]
    },
    {
      "id": "security",
      "title": "Crypto and Safety",
      "state": "open",
      "labels": [
        "security"
      ]
    }
  ],
  "issueTransitions": [
    {
      "id": "accept",
      "title": "Accept issue",
      "from": "proposed",
      "to": "accepted",
      "actor": "person"
    },
    {
      "id": "todo",
      "title": "Promote to TODO",
      "from": "accepted",
      "to": "todo",
      "actor": "person"
    },
    {
      "id": "needs-repro",
      "title": "Request minimal reproduction",
      "from": "proposed",
      "to": "needs-repro",
      "actor": "person"
    },
    {
      "id": "decline",
      "title": "Decline issue",
      "from": "proposed",
      "to": "not-accepted",
      "actor": "person"
    }
  ],
  "contributes": {
    "triggers": [
      {
        "on": "github.push",
        "flow": "ci",
        "title": "CI and Lighthouse audit on main",
        "branches": [
          "main"
        ]
      },
      {
        "on": "github.pull_request",
        "flow": "ci",
        "title": "CI and Lighthouse audit on pull requests",
        "branches": [
          "main"
        ]
      },
      {
        "on": "github.pull_request",
        "flow": "uphill",
        "title": "Uphill Lighthouse backpressure audit on pull requests",
        "branches": [
          "main"
        ]
      },
      {
        "on": "github.push",
        "flow": "docs-publish",
        "title": "Verify docs, build playground, and refresh wiki feeds on main",
        "branches": [
          "main"
        ]
      },
      {
        "on": "github.push",
        "flow": "release",
        "title": "Rehearse npm release and packaging verification on main",
        "branches": [
          "main"
        ],
        "tags": [
          "v*"
        ]
      },
      {
        "on": "manual",
        "flow": "ci",
        "title": "Run Voltaire CI manually"
      },
      {
        "on": "manual",
        "flow": "uphill",
        "title": "Run Lighthouse backpressure audit manually"
      },
      {
        "on": "manual",
        "flow": "release",
        "title": "Run release rehearsal manually"
      }
    ]
  }
}
