{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": true,
		"rootDir": "src",
		"outDir": "dist",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"noEmitOnError": true,
		"allowArbitraryExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"rootDirs": ["src", ".vibe/declarations"],
		"types": []
	},
	"vibe": {
		"sidecarDir": ".vibe/declarations"
	},
	"include": ["src/**/*.vibe", "src/**/*.ts"],
	"exclude": ["node_modules", "dist", ".vibe"]
}
