{
	"name": "voltaire-effect",
	"version": "2.0.0",
	"description": "Effect 4 integration for Voltaire Ethereum primitives, cryptography, transports, providers, signers, contracts, and streams — written in VibeLang",
	"author": "TEVM",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/evmts/voltaire.git",
		"directory": "packages/voltaire-effect"
	},
	"homepage": "https://github.com/evmts/voltaire/tree/main/packages/voltaire-effect",
	"bugs": {
		"url": "https://github.com/evmts/voltaire/issues"
	},
	"keywords": [
		"ethereum",
		"effect",
		"effect-ts",
		"vibelang",
		"voltaire",
		"crypto",
		"blockchain",
		"web3",
		"primitives",
		"typed-errors"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src",
		"!src/**/*.test.*",
		"!src/testing",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"vibelang-source": "./src/index.vibe",
			"import": "./dist/index.js"
		},
		"./errors": {
			"types": "./dist/errors.d.ts",
			"vibelang-source": "./src/errors.vibe",
			"import": "./dist/errors.js"
		},
		"./primitives": {
			"types": "./dist/primitives/index.d.ts",
			"vibelang-source": "./src/primitives/index.vibe",
			"import": "./dist/primitives/index.js"
		},
		"./crypto": {
			"types": "./dist/crypto/index.d.ts",
			"vibelang-source": "./src/crypto/index.vibe",
			"import": "./dist/crypto/index.js"
		},
		"./transport": {
			"types": "./dist/transport/index.d.ts",
			"vibelang-source": "./src/transport/index.vibe",
			"import": "./dist/transport/index.js"
		},
		"./provider": {
			"types": "./dist/provider/index.d.ts",
			"vibelang-source": "./src/provider/index.vibe",
			"import": "./dist/provider/index.js"
		},
		"./contract": {
			"types": "./dist/contract/index.d.ts",
			"vibelang-source": "./src/contract/index.vibe",
			"import": "./dist/contract/index.js"
		},
		"./signer": {
			"types": "./dist/signer/index.d.ts",
			"vibelang-source": "./src/signer/index.vibe",
			"import": "./dist/signer/index.js"
		},
		"./streams": {
			"types": "./dist/streams/index.d.ts",
			"vibelang-source": "./src/streams/index.vibe",
			"import": "./dist/streams/index.js"
		},
		"./standards": {
			"types": "./dist/standards/index.d.ts",
			"vibelang-source": "./src/standards/index.vibe",
			"import": "./dist/standards/index.js"
		},
		"./services": {
			"types": "./dist/services/index.d.ts",
			"vibelang-source": "./src/services/index.vibe",
			"import": "./dist/services/index.js"
		}
	},
	"sideEffects": false,
	"dependencies": {
		"vibelang-runtime": "0.0.13"
	},
	"peerDependencies": {
		"@tevm/voltaire": "workspace:^",
		"effect": "4.1.1"
	},
	"devDependencies": {
		"@effect/platform-node": "4.1.1",
		"@effect/vitest": "4.1.1",
		"@tevm/voltaire": "workspace:*",
		"@types/node": "^26.6.10",
		"effect": "4.1.1",
		"vibelang": "0.0.13",
		"vibelang-vite": "0.0.13",
		"vite": "^8.3.8",
		"vitest": "5.1.2"
	},
	"scripts": {
		"build": "rm -rf dist && vibelang -p tsconfig.build.json",
		"clean": "rm -rf dist .vibe",
		"format": "vibelang format --write 'src/**/*.vibe'",
		"format:check": "vibelang format --check 'src/**/*.vibe'",
		"lint": "vibelang lint",
		"prepublishOnly": "pnpm run typecheck && pnpm run build && pnpm run test:run",
		"test": "vitest",
		"test:run": "vitest run",
		"typecheck": "vibelang --noEmit"
	}
}
