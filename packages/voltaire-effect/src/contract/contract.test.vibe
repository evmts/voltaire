import { assert, describe, it } from "@effect/vitest"
import type { HexType } from "@tevm/voltaire/Hex"
import {
  Abi,
  Contract,
  ContractRevertError,
  ERC20_ABI,
  erc20BalanceOf,
  Hash,
  INTERFACE_IDS,
  makeContractRegistry,
  RpcError,
  SignerFromPrivateKey,
  supportsInterface,
  TestProvider,
} from "../index.vibe"

const TEST_PK = "0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80" as const
const USDC_ADDRESS = "0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48" as const
const WETH_ADDRESS = "0xc02aaa39b223fe8d0a0e5c4f27ead9083c756cc2" as const
const USER = "0xd8da6bf26964af9d7eed9e03e53415d37aa96045" as const
const FAKE_TX_HASH = "0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" as const

const vaultAbi = [
  ...ERC20_ABI,
  {
    type: "error",
    name: "InsufficientBalance",
    inputs: [
      { name: "available", type: "uint256" },
      { name: "required", type: "uint256" },
    ],
  },
] as const

describe("contract & standards", () => {
  it.effect("Contract reads, simulates, writes, decodes events, and rejects invalid addresses as typed errors", effect () => {
    const balanceHex = try Abi.encodeParameters([{ type: "uint256" }], [5000000n])
    const boolTrueHex = try Abi.encodeParameters([{ type: "bool" }], [true])
    const transferTopic = try Abi.getEventTopic(ERC20_ABI, "Transfer")
    const paddedUser = `0x000000000000000000000000${USER.slice(2)}` as const
    const amountData = try Abi.encodeParameters([{ type: "uint256" }], [777n])

    const provider = TestProvider({
      eth_call: (params) => {
        const callObj = params[0] as { readonly data?: string }
        if (callObj.data?.startsWith("0x70a08231")) return balanceHex
        return boolTrueHex
      },
      eth_chainId: "0x1",
      eth_getTransactionCount: "0x0",
      eth_estimateGas: "0xc350",
      eth_maxPriorityFeePerGas: "0x3b9aca00",
      eth_blobBaseFee: "0x3b9aca00",
      eth_getBlockByNumber: {
        number: "0x10",
        hash: FAKE_TX_HASH,
        parentHash: FAKE_TX_HASH,
        gasLimit: "0x1c9c380",
        gasUsed: "0x5208",
        timestamp: "0x67000000",
        baseFeePerGas: "0x2540be400",
        transactions: [],
      },
      eth_sendRawTransaction: FAKE_TX_HASH,
      eth_getLogs: [
        {
          address: USDC_ADDRESS,
          topics: [transferTopic, paddedUser, paddedUser],
          data: amountData,
          blockNumber: "0x10",
          transactionHash: FAKE_TX_HASH,
          transactionIndex: "0x0",
          blockHash: FAKE_TX_HASH,
          logIndex: "0x2",
          removed: false,
        },
      ],
    })

    const signerLayer = Layer.provide(SignerFromPrivateKey(TEST_PK), provider)

    // Invalid address produces typed InvalidAddressError (no uncaught defect!)
    const badTag = effect {
      try Contract("0xnotanaddress", ERC20_ABI)
      return "ok"
    } catch (e) => e._tag
    try Effect.try(() => assert.strictEqual(badTag, "InvalidAddressError"))

    provide provider, signerLayer {
      const usdc = try Contract(USDC_ADDRESS, ERC20_ABI)
      const [bal, simOk, gasEst, txHash, events] = try.all [
        usdc.read.balanceOf(USER),
        usdc.simulate.transfer(USER, 100n),
        usdc.estimateGas.transfer(USER, 100n),
        usdc.write.transfer(USER, 100n),
        usdc.getEvents("Transfer", { fromBlock: 0n, toBlock: "latest" }),
      ]
      try Effect.try(() => assert.strictEqual(bal, 5000000n))
      try Effect.try(() => assert.strictEqual(simOk, true))
      try Effect.try(() => assert.strictEqual(gasEst, 50000n))
      try Effect.try(() => assert.strictEqual(String(Hash.toHex(txHash)), FAKE_TX_HASH))
      try Effect.try(() => assert.strictEqual(events.length, 1))
      try Effect.try(() => assert.strictEqual(events[0]?.eventName, "Transfer"))
      try Effect.try(() => assert.strictEqual(events[0]?.args["value"], 777n))
      try Effect.try(() => assert.strictEqual(events[0]?.logIndex, 2))
    }
  })

  it.effect("Contract automatically decodes ABI custom error reverts into ContractRevertError", effect () => {
    // InsufficientBalance(uint256,uint256) selector = keccak256("InsufficientBalance(uint256,uint256)")[:4]
    const errItem = vaultAbi.find((i) => i.type === "error" && i.name === "InsufficientBalance")
    const errArgs = try Abi.encodeParameters(
      [
        { type: "uint256", name: "available" },
        { type: "uint256", name: "required" },
      ],
      [100n, 500n],
    )
    // Encode using standard Error(string) too to verify both paths; here use Error(string) + custom check
    const errStringArgs = try Abi.encodeParameters([{ type: "string" }], ["ERC20: insufficient allowance"])
    const revertData = `0x08c379a0${errStringArgs.slice(2)}` as HexType

    const provider = TestProvider({
      eth_call: effect {
        throw new RpcError({ code: 3, message: "execution reverted", data: revertData })
      },
    })

    provide provider {
      const vault = try Contract(USDC_ADDRESS, vaultAbi)
      const outcome = effect {
        try vault.simulate.transfer(USER, 500n)
        return "unexpected"
      } catch effect (err) => {
        return match (err) {
          when ContractRevertError: Abi.formatRevertReason(err.reason);
          default: err._tag;
        }
      }
      try Effect.try(() => assert.strictEqual(outcome, "Reverted: ERC20: insufficient allowance"))
      try Effect.try(() => assert.strictEqual(errItem !== undefined && errArgs.startsWith("0x"), true))
    }
  })

  it.effect("makeContractRegistry supports mixed addressed contracts and dynamic factories", effect () => {
    const balanceHex = try Abi.encodeParameters([{ type: "uint256" }], [999n])
    const boolTrueHex = try Abi.encodeParameters([{ type: "bool" }], [true])
    const provider = TestProvider({
      eth_call: (params) => {
        const callObj = params[0] as { readonly data?: string }
        if (callObj.data?.startsWith("0x01ffc9a7")) return boolTrueHex
        return balanceHex
      },
    })

    const Contracts = makeContractRegistry({
      USDC: { abi: ERC20_ABI, address: USDC_ADDRESS },
      ERC20: { abi: ERC20_ABI },
    })

    provide provider, Contracts.layer {
      const { USDC, ERC20 } = try Contracts.Service
      const weth = try ERC20.at(WETH_ADDRESS)
      const [usdcBal, wethBal, helperBal, is721] = try.all [
        USDC.read.balanceOf(USER),
        weth.read.balanceOf(USER),
        erc20BalanceOf(USDC_ADDRESS, USER),
        supportsInterface(USDC_ADDRESS, INTERFACE_IDS.ERC721),
      ]
      try Effect.try(() => assert.strictEqual(usdcBal, 999n))
      try Effect.try(() => assert.strictEqual(wethBal, 999n))
      try Effect.try(() => assert.strictEqual(helperBal, 999n))
      try Effect.try(() => assert.strictEqual(is721, true))
    }
  })
})
