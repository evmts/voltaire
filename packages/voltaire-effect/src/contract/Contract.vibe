// Type-safe Contract factory and ContractRegistry with automatic revert decoding and zero hidden throws.

import type { AddressType } from "@tevm/voltaire/Address"
import type { HashType } from "@tevm/voltaire/Hash"
import type { HexType } from "@tevm/voltaire/Hex"
import {
  ContractCallError,
  ContractEventError,
  ContractRevertError,
  ContractWriteError,
  errorMessage,
  InvalidAddressError,
  RpcError,
} from "../errors.vibe"
import * as Abi from "../primitives/Abi.vibe"
import * as Address from "../primitives/Address.vibe"
import { call, estimateGas as providerEstimateGas, getLogs } from "../provider/Actions.vibe"
import { Signer } from "../signer/Signer.vibe"
import { Transport } from "../transport/Transport.vibe"
import type {
  ContractEventFilter,
  ContractFactory,
  ContractInstance,
  ContractRegistry,
  ContractRegistryConfig,
  ContractRegistryShape,
  DecodedEvent,
  ExtractEventNames,
  ReadOptions,
  WriteOptions,
} from "./types.vibe"

export type * from "./types.vibe"

function isReadOptionsObject(value: unknown): value is ReadOptions {
  if (!Predicate.isObject(value) || Array.isArray(value)) return false
  return "block" in value || "from" in value
}

function isWriteOptionsObject(value: unknown): value is WriteOptions {
  if (!Predicate.isObject(value) || Array.isArray(value)) return false
  return (
    "value" in value
    || "gasLimit" in value
    || "gasPrice" in value
    || "maxFeePerGas" in value
    || "maxPriorityFeePerGas" in value
    || "nonce" in value
  )
}

function splitReadArgs(argsAndOpts: ReadonlyArray<unknown>, inputCount: number): {
  readonly args: ReadonlyArray<unknown>
  readonly options: ReadOptions
} {
  if (argsAndOpts.length > inputCount) {
    const last = argsAndOpts[argsAndOpts.length - 1]
    if (last === undefined) {
      return { args: argsAndOpts.slice(0, inputCount), options: {} }
    }
    if (
      isReadOptionsObject(last) || (Predicate.isObject(last) && !Array.isArray(last) && Object.keys(last).length === 0)
    ) {
      return { args: argsAndOpts.slice(0, -1), options: last as ReadOptions }
    }
  }
  return { args: argsAndOpts, options: {} }
}

function splitWriteArgs(argsAndOpts: ReadonlyArray<unknown>, inputCount: number): {
  readonly args: ReadonlyArray<unknown>
  readonly options: WriteOptions
} {
  if (argsAndOpts.length > inputCount) {
    const last = argsAndOpts[argsAndOpts.length - 1]
    if (last === undefined) {
      return { args: argsAndOpts.slice(0, inputCount), options: {} }
    }
    if (
      isWriteOptionsObject(last) || (Predicate.isObject(last) && !Array.isArray(last) && Object.keys(last).length === 0)
    ) {
      return { args: argsAndOpts.slice(0, -1), options: last as WriteOptions }
    }
  }
  return { args: argsAndOpts, options: {} }
}

// Converts an eth_call / eth_estimateGas error into ContractRevertError (with decoded reason) or ContractCallError.
effect function mapCallError(
  addressHex: string,
  method: string,
  abi: Abi.Abi,
  cause: unknown,
): never!(ContractCallError | ContractRevertError) {
  if (cause instanceof RpcError && cause.isRevert) {
    const rawData = cause.revertData ?? "0x"
    const reason = try Abi.decodeRevertReason(rawData, abi)
    throw new ContractRevertError({
      address: addressHex,
      method,
      reason,
      rawData,
      message: `${method} on ${addressHex}: ${Abi.formatRevertReason(reason)}`,
    })
  }
  throw new ContractCallError({
    address: addressHex,
    method,
    message: `${method} on ${addressHex} failed: ${errorMessage(cause)}`,
    cause,
  })
}

// Creates a type-safe ContractInstance with .read, .write, .simulate, .estimateGas, and .getEvents.
export effect function Contract<const TAbi extends Abi.Abi>(
  addressInput: Address.AddressInput,
  abi: TAbi,
): ContractInstance<TAbi>!InvalidAddressError {
  const address: AddressType = typeof addressInput === "string"
    ? try Address.fromHex(addressInput)
    : addressInput
  const addressHex = Address.toHex(address)

  const readRecord: Record<
    string,
    (...args: ReadonlyArray<unknown>) => unknown!(ContractCallError | ContractRevertError)!Transport
  > = {}
  const simulateRecord: Record<
    string,
    (...args: ReadonlyArray<unknown>) => unknown!(ContractCallError | ContractRevertError)!Transport
  > = {}
  const estimateGasRecord: Record<
    string,
    (...args: ReadonlyArray<unknown>) => bigint!(ContractCallError | ContractRevertError)!Transport
  > = {}
  const writeRecord: Record<string, (...args: ReadonlyArray<unknown>) => HashType!ContractWriteError!Signer> = {}

  for (const item of abi) {
    const fnName = item.name
    if (item.type !== "function" || fnName === undefined) continue
    const inputCount = item.inputs?.length ?? 0
    const isReadOnly = item.stateMutability === "view" || item.stateMutability === "pure"

    if (isReadOnly) {
      readRecord[fnName] = effect (...rawArgs: ReadonlyArray<unknown>) => {
        const { args, options } = splitReadArgs(rawArgs, inputCount)
        const data = Abi.encodeFunctionData(abi, fnName, args) catch effect (e) => {
          throw new ContractCallError({ address: addressHex, method: fnName, message: e.message, cause: e })
        }
        const rawResult = call({ to: addressHex, from: options.from, data }, options.block) catch effect (e) => {
          return try mapCallError(addressHex, fnName, abi, e)
        }
        return Abi.decodeFunctionResult(abi, fnName, rawResult) catch effect (e) => {
          throw new ContractCallError({ address: addressHex, method: fnName, message: e.message, cause: e })
        }
      }
    } else {
      simulateRecord[fnName] = effect (...rawArgs: ReadonlyArray<unknown>) => {
        const { args, options } = splitReadArgs(rawArgs, inputCount)
        const data = Abi.encodeFunctionData(abi, fnName, args) catch effect (e) => {
          throw new ContractCallError({ address: addressHex, method: fnName, message: e.message, cause: e })
        }
        const rawResult = call({ to: addressHex, from: options.from, data }, options.block) catch effect (e) => {
          return try mapCallError(addressHex, fnName, abi, e)
        }
        return Abi.decodeFunctionResult(abi, fnName, rawResult) catch effect (e) => {
          throw new ContractCallError({ address: addressHex, method: fnName, message: e.message, cause: e })
        }
      }

      estimateGasRecord[fnName] = effect (...rawArgs: ReadonlyArray<unknown>) => {
        const { args, options } = splitWriteArgs(rawArgs, inputCount)
        const data = Abi.encodeFunctionData(abi, fnName, args) catch effect (e) => {
          throw new ContractCallError({ address: addressHex, method: fnName, message: e.message, cause: e })
        }
        return providerEstimateGas({
          to: addressHex,
          data,
          value: options.value,
          gas: options.gasLimit,
          gasPrice: options.gasPrice,
          maxFeePerGas: options.maxFeePerGas,
          maxPriorityFeePerGas: options.maxPriorityFeePerGas,
        }) catch effect (e) => {
          return try mapCallError(addressHex, fnName, abi, e)
        }
      }

      writeRecord[fnName] = effect (...rawArgs: ReadonlyArray<unknown>) => {
        const signer = try Signer
        const { args, options } = splitWriteArgs(rawArgs, inputCount)
        const data = Abi.encodeFunctionData(abi, fnName, args) catch effect (e) => {
          throw new ContractWriteError({ address: addressHex, method: fnName, message: e.message, cause: e })
        }
        return signer.sendTransaction({
          to: address,
          data,
          value: options.value,
          gasLimit: options.gasLimit,
          gasPrice: options.gasPrice,
          maxFeePerGas: options.maxFeePerGas,
          maxPriorityFeePerGas: options.maxPriorityFeePerGas,
          nonce: options.nonce,
        }) catch effect (e) => {
          throw new ContractWriteError({
            address: addressHex,
            method: fnName,
            message: `${fnName} on ${addressHex} failed: ${e.message}`,
            cause: e,
          })
        }
      }
    }
  }

  const getEvents = effect <E extends ExtractEventNames<TAbi>>(
    eventName: E,
    filter?: ContractEventFilter,
  ): ReadonlyArray<DecodedEvent>!ContractEventError!Transport => {
    const topics = filter?.args !== undefined
      ? Abi.encodeEventTopics(abi, eventName, filter.args) catch effect (e) => {
        throw new ContractEventError({ address: addressHex, event: eventName, message: e.message, cause: e })
      }
      : [
        Abi.getEventTopic(abi, eventName) catch effect (e) => {
          throw new ContractEventError({ address: addressHex, event: eventName, message: e.message, cause: e })
        },
      ]

    const logs = getLogs({
      address: addressHex,
      topics: topics as ReadonlyArray<`0x${string}` | null>,
      fromBlock: filter?.fromBlock,
      toBlock: filter?.toBlock,
    }) catch effect (e) => {
      throw new ContractEventError({
        address: addressHex,
        event: eventName,
        message: `Fetching ${eventName} logs on ${addressHex} failed: ${errorMessage(e)}`,
        cause: e,
      })
    }

    const decoded: Array<DecodedEvent> = []
    for (const log of logs) {
      const args = Abi.decodeEventLog(abi, eventName, log.data, log.topics as ReadonlyArray<HexType>) catch effect (e) => {
          throw new ContractEventError({
            address: addressHex,
            event: eventName,
            message: `Decoding ${eventName} log failed: ${e.message}`,
            cause: e,
          })
        }
      decoded.push({
        eventName,
        args,
        address: log.address,
        blockNumber: log.blockNumber,
        blockHash: log.blockHash,
        transactionHash: log.transactionHash,
        logIndex: log.logIndex,
      })
    }
    return decoded
  }

  return {
    address,
    abi,
    read: readRecord as unknown as ContractInstance<TAbi>["read"],
    write: writeRecord as unknown as ContractInstance<TAbi>["write"],
    simulate: simulateRecord as unknown as ContractInstance<TAbi>["simulate"],
    estimateGas: estimateGasRecord as unknown as ContractInstance<TAbi>["estimateGas"],
    getEvents,
  }
}

module registryHelper {
  import { Context } from "effect"

  /** @throws {never} */
  export function makeRegistryService<Shape>(key: string): Context.Service<Shape, Shape> {
    return Context.Service<Shape, Shape>(key)
  }
}

import { makeRegistryService } from registryHelper

// Defines a typed ContractRegistry Service + Layer supporting pre-addressed contracts, factories, and mixed mode.
export function makeContractRegistry<const TConfig extends ContractRegistryConfig>(
  config: TConfig,
  serviceKey = "voltaire-effect/contract/ContractRegistry",
): ContractRegistry<TConfig> {
  type Shape = ContractRegistryShape<TConfig>
  const Service = makeRegistryService<Shape>(serviceKey)

  const layer = Layer.effect(
    Service,
    effect {
      const registry: Record<string, unknown> = {}
      for (const [name, def] of Object.entries(config)) {
        if (def.address !== undefined) {
          registry[name] = try Contract(def.address, def.abi)
        } else {
          const factory: ContractFactory<Abi.Abi> = {
            abi: def.abi,
            at: (addr) => Contract(addr, def.abi),
          }
          registry[name] = factory
        }
      }
      return registry as Shape
    },
  )

  return { Service, layer }
}
