import type { AddressType } from "@tevm/voltaire/Address"
import type { HashType } from "@tevm/voltaire/Hash"
import type { HexType } from "@tevm/voltaire/Hex"
import type {
  ContractCallError,
  ContractEventError,
  ContractRevertError,
  ContractWriteError,
  InvalidAddressError,
} from "../errors.vibe"
import type { Abi, AbiItem, AbiParameter } from "../primitives/Abi.vibe"
import type { AddressInput } from "../primitives/Address.vibe"
import type { BlockIdentifier } from "../primitives/Uint.vibe"
import type { Signer } from "../signer/Signer.vibe"
import type { Transport } from "../transport/Transport.vibe"

export interface WriteOptions {
  readonly value?: bigint
  readonly gasLimit?: bigint
  readonly gasPrice?: bigint
  readonly maxFeePerGas?: bigint
  readonly maxPriorityFeePerGas?: bigint
  readonly nonce?: bigint
}

export interface ReadOptions {
  readonly block?: BlockIdentifier
  readonly from?: AddressInput
}

export interface ContractEventFilter {
  readonly fromBlock?: BlockIdentifier
  readonly toBlock?: BlockIdentifier
  readonly args?: Record<string, unknown>
}

export interface DecodedEvent {
  readonly eventName: string
  readonly args: Record<string, unknown>
  readonly address: `0x${string}`
  readonly blockNumber: bigint | null
  readonly blockHash: `0x${string}` | null
  readonly transactionHash: `0x${string}` | null
  readonly logIndex: number | null
}

type BytesInput = Uint8Array | HexType | `0x${string}`

type AbiParamToInput<P extends AbiParameter> = P["type"] extends "tuple"
  ? P["components"] extends ReadonlyArray<AbiParameter> ?
      | { readonly [C in P["components"][number] as C["name"] extends string ? C["name"] : never]: AbiParamToInput<C> }
      | ReadonlyArray<unknown>
  : Record<string, unknown> | ReadonlyArray<unknown>
  : P["type"] extends `${infer Elem}[]` ? ReadonlyArray<AbiPrimitiveToInput<Elem, P["components"]>>
  : AbiPrimitiveToInput<P["type"], P["components"]>

type AbiPrimitiveToInput<T extends string, C extends ReadonlyArray<AbiParameter> | undefined = undefined> = T extends
  "tuple" ? C extends ReadonlyArray<AbiParameter> ?
      | { readonly [P in C[number] as P["name"] extends string ? P["name"] : never]: AbiParamToInput<P> }
      | ReadonlyArray<unknown>
  : Record<string, unknown> | ReadonlyArray<unknown>
  : T extends `uint${string}` | `int${string}` ? bigint
  : T extends "address" ? AddressInput
  : T extends "bool" ? boolean
  : T extends "string" ? string
  : T extends `bytes${string}` | "bytes" ? BytesInput
  : unknown

type AbiParamToOutput<P extends AbiParameter> = P["type"] extends "tuple"
  ? P["components"] extends ReadonlyArray<AbiParameter> ? ReadonlyArray<unknown>
  : ReadonlyArray<unknown>
  : P["type"] extends `${infer Elem}[]` ? ReadonlyArray<AbiPrimitiveToOutput<Elem>>
  : AbiPrimitiveToOutput<P["type"]>

type AbiPrimitiveToOutput<T extends string> = T extends `uint${string}` | `int${string}` ? bigint
  : T extends "address" ? `0x${string}`
  : T extends "bool" ? boolean
  : T extends "string" ? string
  : T extends `bytes${string}` | "bytes" ? Uint8Array
  : unknown

type AbiInputsToArgs<TInputs extends ReadonlyArray<AbiParameter>> = {
  readonly [K in keyof TInputs]: TInputs[K] extends AbiParameter ? AbiParamToInput<TInputs[K]> : unknown
}

type AbiOutputsToTuple<TOutputs extends ReadonlyArray<AbiParameter>> = {
  readonly [K in keyof TOutputs]: TOutputs[K] extends AbiParameter ? AbiParamToOutput<TOutputs[K]> : unknown
}

type AbiOutputToTs<TOutputs extends ReadonlyArray<AbiParameter>> = TOutputs extends readonly [] ? undefined
  : TOutputs extends readonly [infer Only extends AbiParameter] ? AbiParamToOutput<Only>
  : AbiOutputsToTuple<TOutputs>

type ExtractViewFunctions<TAbi extends Abi> = Extract<
  TAbi[number],
  { readonly type: "function"; readonly stateMutability: "view" | "pure" }
>

type ExtractWriteFunctions<TAbi extends Abi> = Extract<
  TAbi[number],
  { readonly type: "function"; readonly stateMutability: "nonpayable" | "payable" }
>

type ExtractEvents<TAbi extends Abi> = Extract<TAbi[number], { readonly type: "event" }>

export type ExtractEventNames<TAbi extends Abi> = ExtractEvents<TAbi> extends { readonly name: infer N }
  ? N extends string ? N
  : never
  : never

type ReadArgs<F> = F extends { readonly inputs: infer I extends ReadonlyArray<AbiParameter> }
  ? AbiInputsToArgs<I> extends readonly [] ? [options?: ReadOptions]
  : [...args: AbiInputsToArgs<I>, options?: ReadOptions]
  : [options?: ReadOptions]

type WriteArgs<F> = F extends { readonly inputs: infer I extends ReadonlyArray<AbiParameter> }
  ? AbiInputsToArgs<I> extends readonly [] ? [options?: WriteOptions]
  : [...args: AbiInputsToArgs<I>, options?: WriteOptions]
  : [options?: WriteOptions]

type MethodOutput<F> = F extends { readonly outputs: infer O extends ReadonlyArray<AbiParameter> } ? AbiOutputToTs<O>
  : unknown

export type ContractReadMethods<TAbi extends Abi> = {
  readonly [F in ExtractViewFunctions<TAbi> as F["name"] extends string ? F["name"] : never]: (
    ...args: ReadArgs<F>
  ) => MethodOutput<F>!(ContractCallError | ContractRevertError)!Transport
}

export type ContractSimulateMethods<TAbi extends Abi> = {
  readonly [F in ExtractWriteFunctions<TAbi> as F["name"] extends string ? F["name"] : never]: (
    ...args: ReadArgs<F>
  ) => MethodOutput<F>!(ContractCallError | ContractRevertError)!Transport
}

export type ContractEstimateGasMethods<TAbi extends Abi> = {
  readonly [F in ExtractWriteFunctions<TAbi> as F["name"] extends string ? F["name"] : never]: (
    ...args: WriteArgs<F>
  ) => bigint!(ContractCallError | ContractRevertError)!Transport
}

export type ContractWriteMethods<TAbi extends Abi> = {
  readonly [F in ExtractWriteFunctions<TAbi> as F["name"] extends string ? F["name"] : never]: (
    ...args: WriteArgs<F>
  ) => HashType!ContractWriteError!Signer
}

export interface ContractInstance<TAbi extends Abi> {
  readonly address: AddressType
  readonly abi: TAbi
  readonly read: ContractReadMethods<TAbi>
  readonly write: ContractWriteMethods<TAbi>
  readonly simulate: ContractSimulateMethods<TAbi>
  readonly estimateGas: ContractEstimateGasMethods<TAbi>
  readonly getEvents: <E extends ExtractEventNames<TAbi>>(
    eventName: E,
    filter?: ContractEventFilter,
  ) => ReadonlyArray<DecodedEvent>!ContractEventError!Transport
}

export interface ContractDef<TAbi extends Abi = Abi> {
  readonly abi: TAbi
  readonly address?: AddressInput
}

export type ContractRegistryConfig = {
  readonly [name: string]: ContractDef
}

export interface ContractFactory<TAbi extends Abi> {
  readonly abi: TAbi
  readonly at: (address: AddressInput) => ContractInstance<TAbi>!InvalidAddressError
}

export type ContractRegistryShape<TConfig extends ContractRegistryConfig> = {
  readonly [K in keyof TConfig]: TConfig[K]["address"] extends AddressInput ? ContractInstance<TConfig[K]["abi"]>
    : ContractFactory<TConfig[K]["abi"]>
}

export interface ContractRegistry<TConfig extends ContractRegistryConfig> {
  readonly Service: Context.Service<ContractRegistryShape<TConfig>, ContractRegistryShape<TConfig>>
  readonly layer: Layer.Layer<ContractRegistryShape<TConfig>, InvalidAddressError>
}

export type { Abi, AbiItem, AbiParameter }
