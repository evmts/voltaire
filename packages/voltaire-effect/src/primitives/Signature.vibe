// Effect 4 Schemas and typed operations for Ethereum Signatures.

import type { HexType } from "@tevm/voltaire/Hex"
import type { SignatureType } from "@tevm/voltaire/Signature"
import { errorMessage, InvalidSignatureError } from "../errors.vibe"

module native {
  import { Signature as VoltaireSig, type SignatureType } from "@tevm/voltaire/Signature"
  import type { HexType } from "@tevm/voltaire/Hex"

  export function fromRaw(input: string | Uint8Array): SignatureType {
    return VoltaireSig.from(input as any)
  }

  export function fromHexRaw(hex: string): SignatureType {
    return VoltaireSig.fromHex(hex)
  }

  export function fromSecp256k1Raw(r: Uint8Array, s: Uint8Array, v: number): SignatureType {
    return VoltaireSig.fromSecp256k1(r, s, v)
  }

  export function toTupleRaw(sig: SignatureType): readonly [number, Uint8Array, Uint8Array] {
    return VoltaireSig.toTuple(sig)
  }

  export function normalizeRaw(sig: SignatureType): SignatureType {
    return VoltaireSig.normalize(sig)
  }

  /** @throws {never} */
  export function toHex(sig: SignatureType): HexType {
    return VoltaireSig.toHex(sig) as HexType
  }

  /** @throws {never} */
  export function toBytes(sig: SignatureType): Uint8Array {
    return VoltaireSig.toBytes(sig)
  }

  /** @throws {never} */
  export function getR(sig: SignatureType): Uint8Array {
    return VoltaireSig.getR(sig)
  }

  /** @throws {never} */
  export function getS(sig: SignatureType): Uint8Array {
    return VoltaireSig.getS(sig)
  }

  /** @throws {never} */
  export function getV(sig: SignatureType): number | undefined {
    return VoltaireSig.getV(sig)
  }

  /** @throws {never} */
  export function isCanonical(sig: SignatureType): boolean {
    return VoltaireSig.isCanonical(sig)
  }

  /** @throws {never} */
  export function isSignature(value: unknown): value is SignatureType {
    return VoltaireSig.isSignature(value)
  }

  /** @throws {never} */
  export function equals(a: SignatureType, b: SignatureType): boolean {
    return VoltaireSig.equals(a, b)
  }
}

import {
  equals,
  fromHexRaw,
  fromRaw,
  fromSecp256k1Raw,
  getR,
  getS,
  getV,
  isCanonical,
  isSignature,
  normalizeRaw,
  toBytes,
  toHex,
  toTupleRaw
} from native

export type { SignatureType }
export { equals, getR, getS, getV, isCanonical, isSignature, toBytes, toHex }

export const SignatureTypeSchema = Schema.declare<SignatureType>(
  (u): u is SignatureType => isSignature(u),
  { identifier: "Signature", description: "Cryptographic signature" }
)

export const SignatureHex = Schema.String.pipe(
  Schema.decodeTo(SignatureTypeSchema, {
    decode: SchemaGetter.transformEffect(effect (s, options) => {
      return fromHex(s) catch effect (e) => {
        throw new SchemaIssue.InvalidValue({ message: e.message }, s, options)
      }
    }),
    encode: SchemaGetter.transform((sig): string => toHex(sig))
  })
)

export effect function from(value: SignatureType | string | Uint8Array): SignatureType!InvalidSignatureError {
  if (isSignature(value)) return value
  return try Effect.try({
    try: () => fromRaw(value),
    catch: (cause) => new InvalidSignatureError({ input: value, message: `Invalid signature: ${errorMessage(cause)}`, cause })
  })
}

export effect function fromHex(hex: string): SignatureType!InvalidSignatureError {
  return try Effect.try({
    try: () => fromHexRaw(hex),
    catch: (cause) => new InvalidSignatureError({ input: hex, message: `Invalid hex signature: ${errorMessage(cause)}`, cause })
  })
}

export effect function fromSecp256k1(r: Uint8Array, s: Uint8Array, v: number): SignatureType!InvalidSignatureError {
  return try Effect.try({
    try: () => fromSecp256k1Raw(r, s, v),
    catch: (cause) => new InvalidSignatureError({ input: { r, s, v }, message: `Invalid secp256k1 signature: ${errorMessage(cause)}`, cause })
  })
}

export effect function toTuple(sig: SignatureType): readonly [number, Uint8Array, Uint8Array]!InvalidSignatureError {
  return try Effect.try({
    try: () => toTupleRaw(sig),
    catch: (cause) => new InvalidSignatureError({ input: sig, message: `Failed extracting signature tuple: ${errorMessage(cause)}`, cause })
  })
}

export effect function normalize(sig: SignatureType): SignatureType!InvalidSignatureError {
  return try Effect.try({
    try: () => normalizeRaw(sig),
    catch: (cause) => new InvalidSignatureError({ input: sig, message: `Failed normalizing signature: ${errorMessage(cause)}`, cause })
  })
}
