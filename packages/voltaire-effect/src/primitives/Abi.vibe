// Effect-wrapped ABI encoding, decoding, event logs, and structured revert decoding.

import type { HashType } from "@tevm/voltaire/Hash"
import type { HexType } from "@tevm/voltaire/Hex"
import {
  AbiDecodeError,
  AbiEncodeError,
  AbiItemNotFoundError,
  errorMessage,
  RevertReason
} from "../errors.vibe"

export interface AbiParameter {
  readonly type: string
  readonly name?: string
  readonly indexed?: boolean
  readonly internalType?: string
  readonly components?: ReadonlyArray<AbiParameter>
}

export interface AbiItem {
  readonly type: string
  readonly name?: string
  readonly inputs?: ReadonlyArray<AbiParameter>
  readonly outputs?: ReadonlyArray<AbiParameter>
  readonly stateMutability?: string
  readonly anonymous?: boolean
}

export type Abi = ReadonlyArray<AbiItem>

module native {
  import * as VoltaireAbi from "@tevm/voltaire/Abi"
  import * as VoltaireHex from "@tevm/voltaire/Hex"
  import * as VoltaireHash from "@tevm/voltaire/Hash"
  import type { HashType } from "@tevm/voltaire/Hash"
  import type { HexType } from "@tevm/voltaire/Hex"
  import type { Abi, AbiItem, AbiParameter } from "./Abi.vibe"

  export function encodeFunctionRaw(abi: Abi, functionName: string, args: ReadonlyArray<unknown>): HexType {
    return VoltaireAbi.encodeFunction(abi as any, functionName, args)
  }

  export function decodeFunctionDataRaw(abi: Abi, data: HexType | Uint8Array): { readonly name: string; readonly params: ReadonlyArray<unknown> } {
    return VoltaireAbi.decodeFunction(abi as any, data)
  }

  export function decodeFunctionResultRaw(abi: Abi, functionName: string, data: HexType | Uint8Array): ReadonlyArray<unknown> {
    const fn = abi.find((item) => item.type === "function" && item.name === functionName)
    if (!fn) throw new Error(`Function "${functionName}" not found in ABI`)
    const bytes = typeof data === "string" ? VoltaireHex.toBytes(data) : data
    return VoltaireAbi.Function.decodeResult(fn as any, bytes)
  }

  export function encodeParametersRaw(params: ReadonlyArray<AbiParameter>, values: ReadonlyArray<unknown>): HexType {
    const encoded = VoltaireAbi.encodeParameters(params as any, values as any)
    return VoltaireHex.fromBytes(encoded)
  }

  export function decodeParametersRaw(params: ReadonlyArray<AbiParameter>, data: HexType | Uint8Array): ReadonlyArray<unknown> {
    const bytes = typeof data === "string" ? VoltaireHex.toBytes(data) : data
    return VoltaireAbi.decodeParameters(params as any, bytes)
  }

  export function encodePackedRaw(types: ReadonlyArray<string>, values: ReadonlyArray<unknown>): HexType {
    const encoded = VoltaireAbi.encodePacked(types as any, values as any)
    return typeof encoded === "string" ? (encoded as HexType) : VoltaireHex.fromBytes(encoded)
  }

  export function getFunctionSelectorRaw(fn: AbiItem): HexType {
    const selector = VoltaireAbi.Function.getSelector(fn as any)
    return typeof selector === "string" ? (selector as HexType) : VoltaireHex.fromBytes(selector)
  }

  export function getEventTopicRaw(ev: AbiItem): HexType {
    const selector = VoltaireAbi.Event.getSelector(ev as any)
    return VoltaireHash.toHex(selector) as HexType
  }

  export function encodeEventTopicsRaw(ev: AbiItem, args: Record<string, unknown>): ReadonlyArray<HexType | null> {
    const topics = VoltaireAbi.Event.encodeTopics(ev as any, args)
    return topics.map((t) => (t === null ? null : (VoltaireHash.toHex(t) as HexType)))
  }

  export function decodeEventLogRaw(
    ev: AbiItem,
    data: HexType | Uint8Array,
    topics: ReadonlyArray<HexType | HashType>
  ): Record<string, unknown> {
    const dataBytes = typeof data === "string" ? VoltaireHex.toBytes(data) : data
    const topicHashes = topics.map((t) =>
      typeof t === "string" ? VoltaireHash.fromHex(t) : t
    ) as unknown as readonly HashType[]
    return VoltaireAbi.Event.decodeLog(ev as any, dataBytes, topicHashes) as Record<string, unknown>
  }

  export function getErrorSelectorRaw(errItem: AbiItem): HexType {
    const sel = VoltaireAbi.Error.getSelector(errItem as any)
    return VoltaireHex.fromBytes(sel)
  }

  export function getErrorSignatureRaw(errItem: AbiItem): string {
    return VoltaireAbi.Error.getSignature(errItem as any)
  }

  export function decodeErrorParamsRaw(errItem: AbiItem, dataBytes: Uint8Array): ReadonlyArray<unknown> {
    return VoltaireAbi.Error.decodeParams(errItem as any, dataBytes)
  }

  export function hexToBytesRaw(hex: string): Uint8Array {
    return VoltaireHex.toBytes(hex as HexType)
  }
}

import {
  decodeErrorParamsRaw,
  decodeEventLogRaw,
  decodeFunctionDataRaw,
  decodeFunctionResultRaw,
  decodeParametersRaw,
  encodeEventTopicsRaw,
  encodeFunctionRaw,
  encodePackedRaw,
  encodeParametersRaw,
  getErrorSelectorRaw,
  getErrorSignatureRaw,
  getEventTopicRaw,
  getFunctionSelectorRaw,
  hexToBytesRaw
} from native

const PANIC_DESCRIPTIONS: Record<string, string> = {
  "0": "Generic compiler panic",
  "1": "Assert failed",
  "17": "Arithmetic overflow or underflow",
  "18": "Division or modulo by zero",
  "33": "Conversion to invalid enum value",
  "34": "Incorrectly encoded storage byte array",
  "49": "Pop on empty array",
  "50": "Array index out of bounds",
  "65": "Out of memory",
  "81": "Called zero-initialized function pointer"
}

export effect function findFunction(abi: Abi, name: string): AbiItem!AbiItemNotFoundError {
  const item = abi.find((entry) => entry.type === "function" && entry.name === name)
  if (!item) {
    throw new AbiItemNotFoundError({ kind: "function", name, message: `Function "${name}" not found in ABI` })
  }
  return item
}

export effect function findEvent(abi: Abi, name: string): AbiItem!AbiItemNotFoundError {
  const item = abi.find((entry) => entry.type === "event" && entry.name === name)
  if (!item) {
    throw new AbiItemNotFoundError({ kind: "event", name, message: `Event "${name}" not found in ABI` })
  }
  return item
}

export effect function findError(abi: Abi, name: string): AbiItem!AbiItemNotFoundError {
  const item = abi.find((entry) => entry.type === "error" && entry.name === name)
  if (!item) {
    throw new AbiItemNotFoundError({ kind: "error", name, message: `Error "${name}" not found in ABI` })
  }
  return item
}

export effect function encodeFunctionData(
  abi: Abi,
  functionName: string,
  args: ReadonlyArray<unknown> = []
): HexType!(AbiItemNotFoundError | AbiEncodeError) {
  try findFunction(abi, functionName)
  return try Effect.try({
    try: () => encodeFunctionRaw(abi, functionName, args),
    catch: (cause) =>
      new AbiEncodeError({
        functionName,
        message: `Failed encoding "${functionName}": ${errorMessage(cause)}`,
        cause
      })
  })
}

export effect function decodeFunctionData(
  abi: Abi,
  data: HexType | Uint8Array
): { readonly name: string; readonly params: ReadonlyArray<unknown> }!AbiDecodeError {
  return try Effect.try({
    try: () => decodeFunctionDataRaw(abi, data),
    catch: (cause) =>
      new AbiDecodeError({
        data: typeof data === "string" ? data : undefined,
        message: `Failed decoding function calldata: ${errorMessage(cause)}`,
        cause
      })
  })
}

export effect function decodeFunctionResult(
  abi: Abi,
  functionName: string,
  data: HexType | Uint8Array
): unknown!(AbiItemNotFoundError | AbiDecodeError) {
  const fn = try findFunction(abi, functionName)
  const decoded = try Effect.try({
    try: () => decodeFunctionResultRaw(abi, functionName, data),
    catch: (cause) =>
      new AbiDecodeError({
        functionName,
        data: typeof data === "string" ? data : undefined,
        message: `Failed decoding result for "${functionName}": ${errorMessage(cause)}`,
        cause
      })
  })
  const outputCount = fn.outputs?.length ?? 0
  if (outputCount === 0) return undefined
  if (outputCount === 1) return decoded[0]
  return decoded
}

export effect function encodeParameters(
  params: ReadonlyArray<AbiParameter>,
  values: ReadonlyArray<unknown>
): HexType!AbiEncodeError {
  return try Effect.try({
    try: () => encodeParametersRaw(params, values),
    catch: (cause) => new AbiEncodeError({ message: `Failed encoding ABI parameters: ${errorMessage(cause)}`, cause })
  })
}

export effect function decodeParameters(
  params: ReadonlyArray<AbiParameter>,
  data: HexType | Uint8Array
): ReadonlyArray<unknown>!AbiDecodeError {
  return try Effect.try({
    try: () => decodeParametersRaw(params, data),
    catch: (cause) =>
      new AbiDecodeError({
        data: typeof data === "string" ? data : undefined,
        message: `Failed decoding ABI parameters: ${errorMessage(cause)}`,
        cause
      })
  })
}

export effect function encodePacked(
  types: ReadonlyArray<string>,
  values: ReadonlyArray<unknown>
): HexType!AbiEncodeError {
  return try Effect.try({
    try: () => encodePackedRaw(types, values),
    catch: (cause) => new AbiEncodeError({ message: `Failed packed ABI encoding: ${errorMessage(cause)}`, cause })
  })
}

export effect function getFunctionSelector(abi: Abi, functionName: string): HexType!(AbiItemNotFoundError | AbiEncodeError) {
  const fn = try findFunction(abi, functionName)
  return try Effect.try({
    try: () => getFunctionSelectorRaw(fn),
    catch: (cause) => new AbiEncodeError({ functionName, message: `Failed computing selector: ${errorMessage(cause)}`, cause })
  })
}

export effect function getEventTopic(abi: Abi, eventName: string): HexType!(AbiItemNotFoundError | AbiEncodeError) {
  const ev = try findEvent(abi, eventName)
  return try Effect.try({
    try: () => getEventTopicRaw(ev),
    catch: (cause) => new AbiEncodeError({ functionName: eventName, message: `Failed computing event topic: ${errorMessage(cause)}`, cause })
  })
}

export effect function encodeEventTopics(
  abi: Abi,
  eventName: string,
  args: Record<string, unknown> = {}
): ReadonlyArray<HexType | null>!(AbiItemNotFoundError | AbiEncodeError) {
  const ev = try findEvent(abi, eventName)
  return try Effect.try({
    try: () => encodeEventTopicsRaw(ev, args),
    catch: (cause) => new AbiEncodeError({ functionName: eventName, message: `Failed encoding event topics: ${errorMessage(cause)}`, cause })
  })
}

export effect function decodeEventLog(
  abi: Abi,
  eventName: string,
  data: HexType | Uint8Array,
  topics: ReadonlyArray<HexType | HashType>
): Record<string, unknown>!(AbiItemNotFoundError | AbiDecodeError) {
  const ev = try findEvent(abi, eventName)
  return try Effect.try({
    try: () => decodeEventLogRaw(ev, data, topics),
    catch: (cause) =>
      new AbiDecodeError({
        functionName: eventName,
        data: typeof data === "string" ? data : undefined,
        message: `Failed decoding event "${eventName}": ${errorMessage(cause)}`,
        cause
      })
  })
}

// Decodes Solidity Error(string), Panic(uint256), and ABI-declared custom errors.
export effect function decodeRevertReason(data: string, abi?: Abi): RevertReason!! {
  const normalized = data.toLowerCase()
  if (!normalized.startsWith("0x") || normalized.length < 10) {
    return RevertReason.Raw({ data })
  }
  const selector = normalized.slice(0, 10)
  const payloadHex = `0x${normalized.slice(10)}` as HexType

  // Error(string) -> 0x08c379a0
  if (selector === "0x08c379a0") {
    const decoded = decodeParameters([{ type: "string" }], payloadHex) catch () => undefined
    if (decoded !== undefined && typeof decoded[0] === "string") {
      return RevertReason.ErrorString({ reason: decoded[0] })
    }
  }

  // Panic(uint256) -> 0x4e487b71
  if (selector === "0x4e487b71") {
    const decoded = decodeParameters([{ type: "uint256" }], payloadHex) catch () => undefined
    if (decoded !== undefined && typeof decoded[0] === "bigint") {
      const code = decoded[0]
      const description = PANIC_DESCRIPTIONS[code.toString()] ?? `Unknown panic code 0x${code.toString(16)}`
      return RevertReason.Panic({ code, description })
    }
  }

  // Match against ABI custom error items
  if (abi !== undefined) {
    const fullBytes = Effect.try(() => hexToBytesRaw(normalized)) catch () => undefined
    if (fullBytes !== undefined) {
      for (const item of abi) {
        const errName = item.name
        if (item.type !== "error" || errName === undefined) continue
        const errSel = Effect.try(() => getErrorSelectorRaw(item).toLowerCase()) catch () => undefined
        if (errSel !== selector) continue
        const signature = Effect.try(() => getErrorSignatureRaw(item)) catch () => errName
        const args = Effect.try(() => decodeErrorParamsRaw(item, fullBytes)) catch () => []
        return RevertReason.Custom({ name: errName, signature, args })
      }
    }
  }

  return RevertReason.Raw({ data })
}

export function formatRevertReason(reason: RevertReason): string {
  return match (reason) {
    when { _tag: "ErrorString", reason: let msg }: `Reverted: ${msg}`;
    when { _tag: "Panic", let code, let description }: `Panic(0x${code.toString(16)}): ${description}`;
    when { _tag: "Custom", let name, let args }:
      args.length > 0 ? `Custom error ${name}(${args.map((a) => String(a)).join(", ")})` : `Custom error ${name}()`;
    when { _tag: "Raw", let data }: data === "0x" ? "Execution reverted without reason" : `Reverted with data ${data}`;
  }
}
