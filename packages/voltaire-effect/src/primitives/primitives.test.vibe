import { assert, describe, it } from "@effect/vitest"
import { KeccakLive } from "../crypto/Keccak.vibe"
import { Abi, Address, Hash, Hex, Siwe, Uint, Unit } from "./index.vibe"

const VITALIK_LOWER = "0xd8da6bf26964af9d7eed9e03e53415d37aa96045"
const VITALIK_CHECKSUM = "0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045"

const erc20Abi = [
  {
    type: "function",
    name: "balanceOf",
    stateMutability: "view",
    inputs: [{ name: "account", type: "address" }],
    outputs: [{ name: "", type: "uint256" }]
  },
  {
    type: "function",
    name: "transfer",
    stateMutability: "nonpayable",
    inputs: [
      { name: "to", type: "address" },
      { name: "amount", type: "uint256" }
    ],
    outputs: [{ name: "", type: "bool" }]
  },
  {
    type: "event",
    name: "Transfer",
    inputs: [
      { name: "from", type: "address", indexed: true },
      { name: "to", type: "address", indexed: true },
      { name: "value", type: "uint256", indexed: false }
    ]
  },
  {
    type: "error",
    name: "InsufficientBalance",
    inputs: [
      { name: "available", type: "uint256" },
      { name: "required", type: "uint256" }
    ]
  }
] as const

describe("primitives", () => {
  it.effect("Address parses, formats, and verifies EIP-55 checksum with Keccak", effect () => {
    provide KeccakLive {
      const addr = try Address.fromHex(VITALIK_LOWER)
      const checksummed = try Address.toChecksummed(addr)
      const validOk = try Address.isValidChecksum(VITALIK_CHECKSUM)
      const validBad = try Address.isValidChecksum(VITALIK_LOWER)
      try Effect.try(() => assert.strictEqual(checksummed, VITALIK_CHECKSUM))
      try Effect.try(() => assert.strictEqual(validOk, true))
      try Effect.try(() => assert.strictEqual(validBad, false))

      const decoded = try Schema.decodeUnknownEffect(Address.AddressChecksummed)(VITALIK_CHECKSUM)
      try Effect.try(() => assert.strictEqual(Address.equals(decoded, addr), true))

      const badExit = try exit(Schema.decodeUnknownEffect(Address.AddressChecksummed)(VITALIK_LOWER))
      try Effect.try(() => assert.strictEqual(Exit.isFailure(badExit), true))
    }
  })

  it.effect("Address fails with typed InvalidAddressError on bad input", effect () => {
    const tag = effect {
      try Address.fromHex("0x1234")
      return "ok"
    } catch (e) => e._tag
    try Effect.try(() => assert.strictEqual(tag, "InvalidAddressError"))
  })

  it.effect("Hex schema and operations work with deterministic Random", effect () => {
    const hex = try Hex.fromBigInt(255n, 2)
    const big = try Hex.toBigInt(hex)
    try Effect.try(() => assert.strictEqual(hex, "0x00ff"))
    try Effect.try(() => assert.strictEqual(big, 255n))
    const rnd = try Hex.random(16)
    try Effect.try(() => assert.strictEqual(Hex.size(rnd), 16))
  })

  it.effect("Hash roundtrips through HashHex and HashBytes schemas", effect () => {
    const zeroHash = Hash.zero()
    const encoded = try Schema.encodeEffect(Hash.HashHex)(zeroHash)
    const decoded = try Schema.decodeUnknownEffect(Hash.HashHex)(encoded)
    try Effect.try(() => assert.strictEqual(Hash.isZero(decoded), true))
    try Effect.try(() => assert.strictEqual(Hash.equals(decoded, zeroHash), true))
  })

  it.effect("Uint QuantityHex and QuantityNumber roundtrip accurately", effect () => {
    const big = try Schema.decodeUnknownEffect(Uint.QuantityHex)("0xde0b6b3a7640000")
    try Effect.try(() => assert.strictEqual(big, 1000000000000000000n))
    const encoded = try Schema.encodeEffect(Uint.QuantityHex)(big)
    try Effect.try(() => assert.strictEqual(encoded, "0xde0b6b3a7640000"))

    const num = try Schema.decodeUnknownEffect(Uint.QuantityNumber)("0x2a")
    try Effect.try(() => assert.strictEqual(num, 42))
  })

  it.effect("Unit parseEther/formatEther/parseGwei preserve exact decimal precision", effect () => {
    const wei = try Unit.parseEther("1.234567890123456789")
    const formattedEth = try Unit.formatEther(wei)
    try Effect.try(() => assert.strictEqual(wei, 1234567890123456789n))
    try Effect.try(() => assert.strictEqual(formattedEth, "1.234567890123456789"))

    const gwei = try Unit.parseGwei("12.345678901")
    const formattedGwei = try Unit.formatGwei(gwei)
    try Effect.try(() => assert.strictEqual(gwei, 12345678901n))
    try Effect.try(() => assert.strictEqual(formattedGwei, "12.345678901"))

    // Reject precision truncation
    const tooPrecise = try exit(Unit.parseGwei("1.0000000001"))
    try Effect.try(() => assert.strictEqual(Exit.isFailure(tooPrecise), true))
  })

  it.effect("Abi encodes/decodes functions and decodes Error(string), Panic, and custom errors", effect () => {
    const calldata = try Abi.encodeFunctionData(erc20Abi, "transfer", [VITALIK_LOWER, 1000n])
    try Effect.try(() => assert.strictEqual(calldata.startsWith("0xa9059cbb"), true))

    const decodedCall = try Abi.decodeFunctionData(erc20Abi, calldata)
    try Effect.try(() => assert.strictEqual(decodedCall.name, "transfer"))
    try Effect.try(() => assert.strictEqual(decodedCall.params[1], 1000n))

    // Decode Error(string)
    const errPayload = try Abi.encodeParameters([{ type: "string" }], ["ERC20: transfer exceeds balance"])
    const revertHex = `0x08c379a0${errPayload.slice(2)}`
    const reason = try Abi.decodeRevertReason(revertHex, erc20Abi)
    try Effect.try(() => assert.strictEqual(Abi.formatRevertReason(reason), "Reverted: ERC20: transfer exceeds balance"))

    // Decode Panic(0x11) = arithmetic overflow
    const panicPayload = try Abi.encodeParameters([{ type: "uint256" }], [0x11n])
    const panicReason = try Abi.decodeRevertReason(`0x4e487b71${panicPayload.slice(2)}`)
    try Effect.try(() => assert.strictEqual(Abi.formatRevertReason(panicReason), "Panic(0x11): Arithmetic overflow or underflow"))
  })

  it.effect("SIWE creates, formats, parses, and validates against TestClock", effect () => {
    const msg = try Siwe.create({
      domain: "voltaire.tevm.sh",
      address: VITALIK_LOWER,
      uri: "https://voltaire.tevm.sh/login",
      chainId: 1,
      statement: "Sign in to Voltaire"
    })
    const formatted = try Siwe.format(msg)
    const parsed = try Siwe.parse(formatted)
    try Effect.try(() => assert.strictEqual(parsed.domain, "voltaire.tevm.sh"))
    const validated = try Siwe.validate(parsed)
    try Effect.try(() => assert.strictEqual(validated.chainId, 1))
  })
})
