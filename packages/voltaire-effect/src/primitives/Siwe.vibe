// EIP-4361 Sign-In with Ethereum (SIWE) using Effect Clock & Random for 100% testability.

import type { AddressType } from "@tevm/voltaire/Address"
import type { SiweMessageType } from "@tevm/voltaire/Siwe"
import { errorMessage, SiweError } from "../errors.vibe"
import { fromHex as addressFromHex } from "./Address.vibe"

module native {
  import * as VoltaireSiwe from "@tevm/voltaire/Siwe"
  import type { AddressType } from "@tevm/voltaire/Address"
  import type { SiweMessageType, ValidationResult } from "@tevm/voltaire/Siwe"

  export function createRaw(params: {
    readonly domain: string
    readonly address: AddressType
    readonly uri: string
    readonly chainId: number
    readonly statement?: string
    readonly expirationTime?: string
    readonly notBefore?: string
    readonly requestId?: string
    readonly resources?: Array<string>
    readonly nonce: string
    readonly issuedAt: string
  }): SiweMessageType {
    return VoltaireSiwe.create(params)
  }

  export function formatRaw(message: SiweMessageType): string {
    return VoltaireSiwe.format(message)
  }

  export function parseRaw(text: string): SiweMessageType {
    return VoltaireSiwe.parse(text)
  }

  export function validateRaw(message: SiweMessageType, nowMillis: number): ValidationResult {
    return VoltaireSiwe.validate(message, { now: new Date(nowMillis) })
  }

  export function verifyMessageRaw(
    message: SiweMessageType,
    signature: Uint8Array,
    nowMillis: number,
  ): ValidationResult {
    return VoltaireSiwe.verifyMessage(message, signature as any, { now: new Date(nowMillis) })
  }
}

import { createRaw, formatRaw, parseRaw, validateRaw, verifyMessageRaw } from native

export type { SiweMessageType }

export interface CreateSiweParams {
  readonly domain: string
  readonly address: AddressType | `0x${string}`
  readonly uri: string
  readonly chainId: number
  readonly statement?: string
  readonly expirationTime?: string
  readonly notBefore?: string
  readonly requestId?: string
  readonly resources?: ReadonlyArray<string>
  readonly nonce?: string
  readonly issuedAt?: string
}

const NONCE_ALPHABET = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

// Generates a deterministic-under-TestRandom alphanumeric SIWE nonce (>= 8 chars).
export effect function generateNonce(length = 17): string!SiweError {
  if (!Number.isInteger(length) || length < 8) {
    throw new SiweError({ message: "SIWE nonce length must be an integer >= 8" })
  }
  let out = ""
  for (let i = 0; i < length; i++) {
    const idx = try Random.nextIntBetween(0, NONCE_ALPHABET.length)
    out += NONCE_ALPHABET[idx] ?? "a"
  }
  return out
}

export effect function create(params: CreateSiweParams): SiweMessageType!SiweError {
  const addr = typeof params.address === "string"
    ? addressFromHex(params.address) catch effect (e) => {
      throw new SiweError({ message: e.message, cause: e })
    }
    : params.address
  const nonce = params.nonce ?? try generateNonce()
  const nowInstant = try DateTime.now
  const issuedAt = params.issuedAt ?? DateTime.formatIso(nowInstant)

  return try Effect.try({
    try: () =>
      createRaw({
        domain: params.domain,
        address: addr,
        uri: params.uri,
        chainId: params.chainId,
        statement: params.statement,
        expirationTime: params.expirationTime,
        notBefore: params.notBefore,
        requestId: params.requestId,
        resources: params.resources ? [...params.resources] : undefined,
        nonce,
        issuedAt,
      }),
    catch: (cause) => new SiweError({ message: `Failed creating SIWE message: ${errorMessage(cause)}`, cause }),
  })
}

export effect function format(message: SiweMessageType): string!SiweError {
  return try Effect.try({
    try: () => formatRaw(message),
    catch: (cause) => new SiweError({ message: `Failed formatting SIWE message: ${errorMessage(cause)}`, cause }),
  })
}

export effect function parse(text: string): SiweMessageType!SiweError {
  return try Effect.try({
    try: () => parseRaw(text),
    catch: (cause) => new SiweError({ message: `Failed parsing SIWE message: ${errorMessage(cause)}`, cause }),
  })
}

// Validates timestamps against Effect Clock (100% testable with TestClock!).
export effect function validate(message: SiweMessageType): SiweMessageType!SiweError {
  const nowMillis = try Clock.currentTimeMillis
  const result = try Effect.try({
    try: () => validateRaw(message, nowMillis),
    catch: (cause) => new SiweError({ message: `SIWE validation failed: ${errorMessage(cause)}`, cause }),
  })
  if (!result.valid) {
    const errText = result.error ? result.error.message : "Invalid SIWE message"
    throw new SiweError({ message: errText, cause: result.error })
  }
  return message
}

export effect function verify(message: SiweMessageType, signature: Uint8Array): SiweMessageType!SiweError {
  const nowMillis = try Clock.currentTimeMillis
  const result = try Effect.try({
    try: () => verifyMessageRaw(message, signature, nowMillis),
    catch: (cause) => new SiweError({ message: `SIWE verification failed: ${errorMessage(cause)}`, cause }),
  })
  if (!result.valid) {
    const errText = result.error ? result.error.message : "Invalid SIWE signature"
    throw new SiweError({ message: errText, cause: result.error })
  }
  return message
}
