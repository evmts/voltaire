// Exact decimal unit parsing & formatting (wei / gwei / ether / arbitrary ERC-20 decimals).
// Uses pure string + BigInt arithmetic — zero floating-point precision loss.

import { InvalidUnitError } from "../errors.vibe"

const DECIMAL_RE = /^(-)?(\d+)(?:\.(\d*))?$/

export effect function parseUnits(value: string, decimals: number): bigint!InvalidUnitError {
  if (!Number.isInteger(decimals) || decimals < 0 || decimals > 78) {
    throw new InvalidUnitError({ input: decimals, message: `Invalid decimals: ${decimals}` })
  }
  const trimmed = value.trim()
  const matched = DECIMAL_RE.exec(trimmed)
  if (!matched) {
    throw new InvalidUnitError({ input: value, message: `Invalid decimal number: "${value}"` })
  }
  const negative = matched[1] === "-"
  const whole = matched[2] ?? "0"
  const rawFraction = matched[3] ?? ""

  // Reject excess non-zero fractional digits rather than silently truncating precision.
  if (rawFraction.length > decimals) {
    const overflow = rawFraction.slice(decimals)
    if (/[1-9]/.test(overflow)) {
      throw new InvalidUnitError({
        input: value,
        message: `Value "${value}" has more than ${decimals} fractional digits`,
      })
    }
  }

  const fraction = rawFraction.slice(0, decimals).padEnd(decimals, "0")
  const combined = `${whole}${fraction}`
  const parsed = try Effect.try({
    try: () => BigInt(combined),
    catch: (cause) => new InvalidUnitError({ input: value, message: `Failed parsing units: "${value}"`, cause }),
  })
  return negative ? -parsed : parsed
}

export effect function formatUnits(value: bigint, decimals: number): string!InvalidUnitError {
  if (!Number.isInteger(decimals) || decimals < 0 || decimals > 78) {
    throw new InvalidUnitError({ input: decimals, message: `Invalid decimals: ${decimals}` })
  }
  if (decimals === 0) return value.toString()

  const negative = value < 0n
  const abs = negative ? -value : value
  const digits = abs.toString().padStart(decimals + 1, "0")
  const splitAt = digits.length - decimals
  const whole = digits.slice(0, splitAt)
  const rawFraction = digits.slice(splitAt).replace(/0+$/, "")
  const sign = negative ? "-" : ""
  return rawFraction.length > 0 ? `${sign}${whole}.${rawFraction}` : `${sign}${whole}`
}

export effect function parseEther(value: string): bigint!InvalidUnitError {
  return try parseUnits(value, 18)
}

export effect function formatEther(wei: bigint): string!InvalidUnitError {
  return try formatUnits(wei, 18)
}

export effect function parseGwei(value: string): bigint!InvalidUnitError {
  return try parseUnits(value, 9)
}

export effect function formatGwei(wei: bigint): string!InvalidUnitError {
  return try formatUnits(wei, 9)
}
