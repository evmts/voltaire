// Effect 4 Schemas and typed operations for Ethereum Hex values.

import type { HexType } from "@tevm/voltaire/Hex"
import { errorMessage, InvalidHexError } from "../errors.vibe"

module native {
  import { Hex as VoltaireHex, type HexType } from "@tevm/voltaire/Hex"

  export function parseHex(value: string | Uint8Array): HexType {
    return VoltaireHex.from(value)
  }

  export function fromBytesRaw(bytes: Uint8Array): HexType {
    return VoltaireHex.fromBytes(bytes)
  }

  export function fromBigIntRaw(value: bigint, size?: number): HexType {
    return VoltaireHex.fromBigInt(value, size)
  }

  export function fromNumberRaw(value: number, size?: number): HexType {
    return VoltaireHex.fromNumber(value, size)
  }

  export function fromStringRaw(value: string): HexType {
    return VoltaireHex.fromString(value)
  }

  export function toBytesRaw(hex: HexType): Uint8Array {
    return VoltaireHex.toBytes(hex)
  }

  export function toBigIntRaw(hex: HexType): bigint {
    return VoltaireHex.toBigInt(hex)
  }

  export function toNumberRaw(hex: HexType): number {
    return VoltaireHex.toNumber(hex)
  }

  export function toStringRaw(hex: HexType): string {
    return VoltaireHex.toString(hex)
  }

  export function concatRaw(items: ReadonlyArray<HexType>): HexType {
    return VoltaireHex.concat(...items)
  }

  export function sliceRaw(hex: HexType, start: number, end?: number): HexType {
    return VoltaireHex.slice(hex, start, end)
  }

  export function padRaw(hex: HexType, targetSize: number): HexType {
    return VoltaireHex.pad(hex, targetSize) as HexType
  }

  export function padRightRaw(hex: HexType, targetSize: number): HexType {
    return VoltaireHex.padRight(hex, targetSize) as HexType
  }

  export function trimRaw(hex: HexType): HexType {
    return VoltaireHex.trim(hex)
  }

  export function xorRaw(a: HexType, b: HexType): HexType {
    return VoltaireHex.xor(a, b)
  }

  /** @throws {never} */
  export function isHex(value: unknown): value is HexType {
    return typeof value === "string" && (value === "0x" || VoltaireHex.isHex(value))
  }

  /** @throws {never} */
  export function size(hex: HexType): number {
    return VoltaireHex.size(hex)
  }

  /** @throws {never} */
  export function equals(a: HexType, b: HexType): boolean {
    return VoltaireHex.equals(a, b)
  }

  /** @throws {never} */
  export function zero(byteLength: number): HexType {
    return VoltaireHex.zero(byteLength)
  }
}

import {
  concatRaw,
  equals,
  fromBigIntRaw,
  fromBytesRaw,
  fromNumberRaw,
  fromStringRaw,
  isHex,
  padRaw,
  padRightRaw,
  parseHex,
  size,
  sliceRaw,
  toBigIntRaw,
  toBytesRaw,
  toNumberRaw,
  toStringRaw,
  trimRaw,
  xorRaw,
  zero,
} from native

export type { HexType }
export { equals, isHex, size, zero }

export const HexTypeSchema = Schema.declare<HexType>(
  (u): u is HexType => isHex(u),
  { identifier: "Hex", description: "0x-prefixed hexadecimal string" },
)

export const HexSchema = Schema.String.pipe(
  Schema.decodeTo(HexTypeSchema, {
    decode: SchemaGetter.transformEffect(effect (s, options) => {
      return from(s) catch effect (e) => {
        throw new SchemaIssue.InvalidValue({ message: e.message }, s, options)
      }
    }),
    encode: SchemaGetter.transform((h): string => h),
  }),
)

export function Sized(byteLength: number) {
  return HexSchema.pipe(
    Schema.check(
      Schema.makeFilter((h) => size(h) === byteLength, {
        message: `Expected hex value of exactly ${byteLength} bytes`,
      }),
    ),
  )
}

export effect function from(value: string | Uint8Array): HexType!InvalidHexError {
  return try Effect.try({
    try: () => parseHex(value),
    catch: (cause) => new InvalidHexError({ input: value, message: `Invalid hex: ${errorMessage(cause)}`, cause }),
  })
}

export effect function fromBytes(bytes: Uint8Array): HexType!InvalidHexError {
  return try Effect.try({
    try: () => fromBytesRaw(bytes),
    catch: (cause) =>
      new InvalidHexError({ input: bytes, message: `Invalid bytes for hex: ${errorMessage(cause)}`, cause }),
  })
}

export effect function fromBigInt(value: bigint, byteSize?: number): HexType!InvalidHexError {
  if (value < 0n) {
    throw new InvalidHexError({ input: value, message: "Cannot encode negative bigint as hex" })
  }
  return try Effect.try({
    try: () => fromBigIntRaw(value, byteSize),
    catch: (cause) =>
      new InvalidHexError({ input: value, message: `Invalid bigint for hex: ${errorMessage(cause)}`, cause }),
  })
}

export effect function fromNumber(value: number, byteSize?: number): HexType!InvalidHexError {
  if (!Number.isInteger(value) || value < 0) {
    throw new InvalidHexError({ input: value, message: "Expected non-negative integer for hex encoding" })
  }
  return try Effect.try({
    try: () => fromNumberRaw(value, byteSize),
    catch: (cause) =>
      new InvalidHexError({ input: value, message: `Invalid number for hex: ${errorMessage(cause)}`, cause }),
  })
}

export effect function fromString(value: string): HexType!InvalidHexError {
  return try Effect.try({
    try: () => fromStringRaw(value),
    catch: (cause) =>
      new InvalidHexError({ input: value, message: `Invalid UTF-8 string for hex: ${errorMessage(cause)}`, cause }),
  })
}

export effect function toBytes(hex: HexType | string): Uint8Array!InvalidHexError {
  const valid = try from(hex)
  return try Effect.try({
    try: () => toBytesRaw(valid),
    catch: (cause) =>
      new InvalidHexError({ input: hex, message: `Failed converting hex to bytes: ${errorMessage(cause)}`, cause }),
  })
}

export effect function toBigInt(hex: HexType | string): bigint!InvalidHexError {
  const valid = try from(hex)
  return try Effect.try({
    try: () => toBigIntRaw(valid),
    catch: (cause) =>
      new InvalidHexError({ input: hex, message: `Failed converting hex to bigint: ${errorMessage(cause)}`, cause }),
  })
}

export effect function toNumber(hex: HexType | string): number!InvalidHexError {
  const valid = try from(hex)
  return try Effect.try({
    try: () => toNumberRaw(valid),
    catch: (cause) =>
      new InvalidHexError({ input: hex, message: `Failed converting hex to number: ${errorMessage(cause)}`, cause }),
  })
}

export effect function toUtf8String(hex: HexType | string): string!InvalidHexError {
  const valid = try from(hex)
  return try Effect.try({
    try: () => toStringRaw(valid),
    catch: (cause) =>
      new InvalidHexError({ input: hex, message: `Failed converting hex to string: ${errorMessage(cause)}`, cause }),
  })
}

export effect function concat(items: ReadonlyArray<HexType | string>): HexType!InvalidHexError {
  const parsed: Array<HexType> = []
  for (const item of items) {
    parsed.push(try from(item))
  }
  return try Effect.try({
    try: () => concatRaw(parsed),
    catch: (cause) =>
      new InvalidHexError({ input: items, message: `Failed concatenating hex: ${errorMessage(cause)}`, cause }),
  })
}

export effect function slice(hex: HexType | string, start: number, end?: number): HexType!InvalidHexError {
  const valid = try from(hex)
  return try Effect.try({
    try: () => sliceRaw(valid, start, end),
    catch: (cause) => new InvalidHexError({ input: hex, message: `Failed slicing hex: ${errorMessage(cause)}`, cause }),
  })
}

export effect function pad(hex: HexType | string, targetSize: number): HexType!InvalidHexError {
  const valid = try from(hex)
  return try Effect.try({
    try: () => padRaw(valid, targetSize),
    catch: (cause) => new InvalidHexError({ input: hex, message: `Failed padding hex: ${errorMessage(cause)}`, cause }),
  })
}

export effect function padRight(hex: HexType | string, targetSize: number): HexType!InvalidHexError {
  const valid = try from(hex)
  return try Effect.try({
    try: () => padRightRaw(valid, targetSize),
    catch: (cause) =>
      new InvalidHexError({ input: hex, message: `Failed right-padding hex: ${errorMessage(cause)}`, cause }),
  })
}

export effect function trim(hex: HexType | string): HexType!InvalidHexError {
  const valid = try from(hex)
  return try Effect.try({
    try: () => trimRaw(valid),
    catch: (cause) =>
      new InvalidHexError({ input: hex, message: `Failed trimming hex: ${errorMessage(cause)}`, cause }),
  })
}

export effect function xor(a: HexType | string, b: HexType | string): HexType!InvalidHexError {
  const hexA = try from(a)
  const hexB = try from(b)
  return try Effect.try({
    try: () => xorRaw(hexA, hexB),
    catch: (cause) =>
      new InvalidHexError({ input: [a, b], message: `Failed XORing hex: ${errorMessage(cause)}`, cause }),
  })
}

// Random hex via Effect's Random service (100% deterministic in tests).
export effect function random(byteLength: number): HexType!InvalidHexError {
  if (!Number.isInteger(byteLength) || byteLength < 0) {
    throw new InvalidHexError({ input: byteLength, message: "Byte length must be a non-negative integer" })
  }
  const bytes = new Uint8Array(byteLength)
  for (let i = 0; i < byteLength; i++) {
    bytes[i] = try Random.nextIntBetween(0, 256)
  }
  return try fromBytes(bytes)
}
