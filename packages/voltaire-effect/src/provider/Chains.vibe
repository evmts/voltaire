// Chain service and built-in Ethereum & L2 chain configurations (including Hoodi!).

export interface NativeCurrency {
  readonly name: string
  readonly symbol: string
  readonly decimals: number
}

export interface ChainContractDeployment {
  readonly address: `0x${string}`
  readonly blockCreated?: number
}

export interface ChainConfig {
  readonly id: number
  readonly name: string
  readonly nativeCurrency: NativeCurrency
  readonly rpcUrls: {
    readonly default: { readonly http: ReadonlyArray<string> }
  }
  readonly blockExplorers?: {
    readonly default: { readonly name: string; readonly url: string }
  }
  readonly contracts?: {
    readonly multicall3?: ChainContractDeployment
    readonly ensUniversalResolver?: ChainContractDeployment
    readonly ensRegistry?: ChainContractDeployment
  }
  readonly testnet?: boolean
}

export service Chain: ChainConfig {
  static readonly key = "voltaire-effect/provider/Chain"
}

export const MULTICALL3_CANONICAL = "0xcA11bde05977b3631167028862bE2a173976CA11" as const

