export function ChainLayer(config: ChainConfig) {
  return Layer.succeed(Chain, config)
}

export const mainnet = ChainLayer(mainnetConfig)
export const sepolia = ChainLayer(sepoliaConfig)
export const hoodi = ChainLayer(hoodiConfig)
export const optimism = ChainLayer(optimismConfig)
export const arbitrum = ChainLayer(arbitrumConfig)
export const base = ChainLayer(baseConfig)
export const polygon = ChainLayer(polygonConfig)
