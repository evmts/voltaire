// High-level, schema-decoded Ethereum JSON-RPC Provider actions requiring only Transport.

import type { HashType } from "@tevm/voltaire/Hash"
import type { HexType } from "@tevm/voltaire/Hex"
import {
  BlockNotFoundError,
  InvalidAddressError,
  InvalidHashError,
  InvalidHexError,
  InvalidUintError,
  ProviderDecodeError,
  ReceiptTimeoutError,
  type RpcTransportError,
  TransactionNotFoundError
} from "../errors.vibe"
import * as Address from "../primitives/Address.vibe"
import * as Hash from "../primitives/Hash.vibe"
import * as Hex from "../primitives/Hex.vibe"
import {
  type BlockIdentifier,
  formatBlockIdentifier,
  formatQuantity
} from "../primitives/Uint.vibe"
import { request, Transport } from "../transport/Transport.vibe"
import {
  decodeFeeHistory,
  decodeQuantityResult,
  decodeRpcBlock,
  decodeRpcLog,
  decodeRpcReceipt,
  decodeRpcTransaction,
  type FeeEstimate,
  type FeeHistory,
  type RpcBlock,
  type RpcLog,
  type RpcTransaction,
  type RpcTransactionReceipt
} from "./Schemas.vibe"

export interface CallRequest {
  readonly to?: Address.AddressInput | null
  readonly from?: Address.AddressInput
  readonly data?: HexType | `0x${string}`
  readonly value?: bigint
  readonly gas?: bigint
  readonly gasPrice?: bigint
  readonly maxFeePerGas?: bigint
  readonly maxPriorityFeePerGas?: bigint
  readonly nonce?: bigint
}

export interface LogFilter {
  readonly address?: Address.AddressInput | ReadonlyArray<Address.AddressInput>
  readonly topics?: ReadonlyArray<`0x${string}` | ReadonlyArray<`0x${string}`> | null>
  readonly fromBlock?: BlockIdentifier
  readonly toBlock?: BlockIdentifier
  readonly blockHash?: `0x${string}` | HashType
}

export interface GetBlockOptions {
  readonly blockNumber?: bigint | number
  readonly blockTag?: "latest" | "earliest" | "pending" | "safe" | "finalized"
  readonly blockHash?: `0x${string}` | HashType
  readonly includeTransactions?: boolean
}

export interface WaitForReceiptOptions {
  /** Number of confirmations to wait for (default: 1) */
  readonly confirmations?: number
  /** Polling interval between checks (default: "1 second") */
  readonly pollingInterval?: Duration.Input
  /** Overall timeout (default: "2 minutes") */
  readonly timeout?: Duration.Input
}

effect function normalizeAddressHex(input: Address.AddressInput): `0x${string}`!InvalidAddressError {
  if (typeof input === "string") {
    const addr = try Address.fromHex(input)
    return Address.toHex(addr)
  }
  return Address.toHex(input)
}

effect function formatCallRequest(tx: CallRequest): Record<string, unknown>!InvalidAddressError {
  const out: Record<string, unknown> = {}
  if (tx.to !== undefined && tx.to !== null) {
    out["to"] = try normalizeAddressHex(tx.to)
  }
  if (tx.from !== undefined) {
    out["from"] = try normalizeAddressHex(tx.from)
  }
  if (tx.data !== undefined) {
    out["data"] = tx.data
  }
  if (tx.value !== undefined) {
    out["value"] = formatQuantity(tx.value)
  }
  if (tx.gas !== undefined) {
    out["gas"] = formatQuantity(tx.gas)
  }
  if (tx.gasPrice !== undefined) {
    out["gasPrice"] = formatQuantity(tx.gasPrice)
  }
  if (tx.maxFeePerGas !== undefined) {
    out["maxFeePerGas"] = formatQuantity(tx.maxFeePerGas)
  }
  if (tx.maxPriorityFeePerGas !== undefined) {
    out["maxPriorityFeePerGas"] = formatQuantity(tx.maxPriorityFeePerGas)
  }
  if (tx.nonce !== undefined) {
    out["nonce"] = formatQuantity(tx.nonce)
  }
  return out
}

export effect function getChainId(): bigint!(RpcTransportError | ProviderDecodeError)!Transport {
  const raw = try request<string>("eth_chainId")
  return try decodeQuantityResult(raw, "eth_chainId")
}

export effect function getBlockNumber(): bigint!(RpcTransportError | ProviderDecodeError)!Transport {
  const raw = try request<string>("eth_blockNumber")
  return try decodeQuantityResult(raw, "eth_blockNumber")
}

export effect function getBalance(
  address: Address.AddressInput,
  block?: BlockIdentifier
): bigint!(RpcTransportError | ProviderDecodeError | InvalidAddressError | InvalidUintError)!Transport {
  const addrHex = try normalizeAddressHex(address)
  const tag = try formatBlockIdentifier(block)
  const raw = try request<string>("eth_getBalance", [addrHex, tag])
  return try decodeQuantityResult(raw, "eth_getBalance")
}

export effect function getCode(
  address: Address.AddressInput,
  block?: BlockIdentifier
): HexType!(RpcTransportError | InvalidAddressError | InvalidUintError | InvalidHexError)!Transport {
  const addrHex = try normalizeAddressHex(address)
  const tag = try formatBlockIdentifier(block)
  const raw = try request<string>("eth_getCode", [addrHex, tag])
  return try Hex.from(raw)
}

export effect function getStorageAt(
  address: Address.AddressInput,
  slot: bigint | HexType | `0x${string}`,
  block?: BlockIdentifier
): HexType!(RpcTransportError | InvalidAddressError | InvalidUintError | InvalidHexError)!Transport {
  const addrHex = try normalizeAddressHex(address)
  const slotHex = typeof slot === "bigint" ? formatQuantity(slot) : try Hex.from(slot)
  const tag = try formatBlockIdentifier(block)
  const raw = try request<string>("eth_getStorageAt", [addrHex, slotHex, tag])
  return try Hex.from(raw)
}

export effect function getTransactionCount(
  address: Address.AddressInput,
  block?: BlockIdentifier
): bigint!(RpcTransportError | ProviderDecodeError | InvalidAddressError | InvalidUintError)!Transport {
  const addrHex = try normalizeAddressHex(address)
  const tag = try formatBlockIdentifier(block)
  const raw = try request<string>("eth_getTransactionCount", [addrHex, tag])
  return try decodeQuantityResult(raw, "eth_getTransactionCount")
}

export effect function getGasPrice(): bigint!(RpcTransportError | ProviderDecodeError)!Transport {
  const raw = try request<string>("eth_gasPrice")
  return try decodeQuantityResult(raw, "eth_gasPrice")
}

export effect function getMaxPriorityFeePerGas(): bigint!(RpcTransportError | ProviderDecodeError)!Transport {
  const raw = try request<string>("eth_maxPriorityFeePerGas")
  return try decodeQuantityResult(raw, "eth_maxPriorityFeePerGas")
}

export effect function getBlobBaseFee(): bigint!(RpcTransportError | ProviderDecodeError)!Transport {
  const raw = try request<string>("eth_blobBaseFee")
  return try decodeQuantityResult(raw, "eth_blobBaseFee")
}

export effect function getFeeHistory(
  blockCount: number | bigint,
  newestBlock: BlockIdentifier = "latest",
  rewardPercentiles: ReadonlyArray<number> = []
): FeeHistory!(RpcTransportError | ProviderDecodeError | InvalidUintError)!Transport {
  const countHex = typeof blockCount === "bigint" ? formatQuantity(blockCount) : `0x${blockCount.toString(16)}`
  const newestTag = try formatBlockIdentifier(newestBlock)
  const raw = try request<unknown>("eth_feeHistory", [countHex, newestTag, rewardPercentiles])
  return try decodeFeeHistory(raw)
}

// Concurrently estimates EIP-1559 (or legacy fallback) fees in a single parallel roundtrip.
export effect function estimateFeesPerGas(options?: {
  /** Base fee multiplier numerator / 100 (default: 120 = 1.2x) */
  readonly baseFeeMultiplierPercent?: bigint
  /** Fallback priority fee if eth_maxPriorityFeePerGas is unsupported (default: 1.5 gwei) */
  readonly defaultPriorityFee?: bigint
}): FeeEstimate!(RpcTransportError | ProviderDecodeError | BlockNotFoundError | InvalidUintError)!Transport {
  const multiplier = options?.baseFeeMultiplierPercent ?? 120n
  const defaultTip = options?.defaultPriorityFee ?? 1500000000n

  const [block, tipOpt, blobFeeOpt] = try.all [
    getBlock({ blockTag: "latest" }),
    effect {
      const tip = getMaxPriorityFeePerGas() catch () => undefined
      return tip
    },
    effect {
      const bf = getBlobBaseFee() catch () => undefined
      return bf
    }
  ]

  if (block.baseFeePerGas !== undefined && block.baseFeePerGas !== null) {
    const baseFee = block.baseFeePerGas
    const priorityFee = tipOpt ?? defaultTip
    const maxFee = (baseFee * multiplier) / 100n + priorityFee
    return {
      type: "eip1559",
      baseFeePerGas: baseFee,
      maxPriorityFeePerGas: priorityFee,
      maxFeePerGas: maxFee,
      maxFeePerBlobGas: blobFeeOpt !== undefined ? (blobFeeOpt * multiplier) / 100n : undefined
    }
  }

  const gasPrice = try getGasPrice()
  return {
    type: "legacy",
    gasPrice
  }
}

export effect function call(
  tx: CallRequest,
  block?: BlockIdentifier
): HexType!(RpcTransportError | InvalidAddressError | InvalidUintError | InvalidHexError)!Transport {
  const formatted = try formatCallRequest(tx)
  const tag = try formatBlockIdentifier(block)
  const raw = try request<string>("eth_call", [formatted, tag])
  return try Hex.from(raw)
}

export effect function estimateGas(
  tx: CallRequest,
  block?: BlockIdentifier
): bigint!(RpcTransportError | ProviderDecodeError | InvalidAddressError | InvalidUintError)!Transport {
  const formatted = try formatCallRequest(tx)
  const params = block !== undefined ? [formatted, try formatBlockIdentifier(block)] : [formatted]
  const raw = try request<string>("eth_estimateGas", params)
  return try decodeQuantityResult(raw, "eth_estimateGas")
}

export effect function getBlock(
  options: GetBlockOptions = {}
): RpcBlock!(RpcTransportError | ProviderDecodeError | BlockNotFoundError | InvalidUintError)!Transport {
  const includeTxs = options.includeTransactions ?? false
  if (options.blockHash !== undefined) {
    const hashHex = typeof options.blockHash === "string" ? options.blockHash : Hash.toHex(options.blockHash)
    const raw = try request<unknown>("eth_getBlockByHash", [hashHex, includeTxs])
    if (raw === null || raw === undefined) {
      throw new BlockNotFoundError({ block: hashHex, message: `Block ${hashHex} not found` })
    }
    return try decodeRpcBlock(raw, "eth_getBlockByHash")
  }

  const selector: BlockIdentifier = options.blockNumber ?? options.blockTag ?? "latest"
  const tag = try formatBlockIdentifier(selector)
  const raw = try request<unknown>("eth_getBlockByNumber", [tag, includeTxs])
  if (raw === null || raw === undefined) {
    throw new BlockNotFoundError({
      block: typeof selector === "bigint" ? selector : String(selector),
      message: `Block ${String(selector)} not found`
    })
  }
  return try decodeRpcBlock(raw, "eth_getBlockByNumber")
}

export effect function getBlockReceipts(
  block: BlockIdentifier = "latest"
): ReadonlyArray<RpcTransactionReceipt>!(RpcTransportError | ProviderDecodeError | InvalidUintError)!Transport {
  const tag = try formatBlockIdentifier(block)
  const raw = try request<unknown>("eth_getBlockReceipts", [tag])
  if (!Array.isArray(raw)) {
    throw new ProviderDecodeError({ method: "eth_getBlockReceipts", message: "Expected array of receipts" })
  }
  const receipts: Array<RpcTransactionReceipt> = []
  for (const item of raw) {
    receipts.push(try decodeRpcReceipt(item, "eth_getBlockReceipts"))
  }
  return receipts
}

export effect function getTransaction(
  hash: HashType | `0x${string}`
): RpcTransaction!(RpcTransportError | ProviderDecodeError | TransactionNotFoundError)!Transport {
  const hashHex = typeof hash === "string" ? hash : Hash.toHex(hash)
  const raw = try request<unknown>("eth_getTransactionByHash", [hashHex])
  if (raw === null || raw === undefined) {
    throw new TransactionNotFoundError({ hash: hashHex, message: `Transaction ${hashHex} not found` })
  }
  return try decodeRpcTransaction(raw, "eth_getTransactionByHash")
}

export effect function getTransactionReceipt(
  hash: HashType | `0x${string}`
): Option.Option<RpcTransactionReceipt>!(RpcTransportError | ProviderDecodeError)!Transport {
  const hashHex = typeof hash === "string" ? hash : Hash.toHex(hash)
  const raw = try request<unknown>("eth_getTransactionReceipt", [hashHex])
  if (raw === null || raw === undefined) {
    return Option.none()
  }
  return Option.some(try decodeRpcReceipt(raw, "eth_getTransactionReceipt"))
}

// Polls for transaction receipt until confirmed to the desired confirmation depth.
export effect function waitForTransactionReceipt(
  hash: HashType | `0x${string}`,
  options: WaitForReceiptOptions = {}
): RpcTransactionReceipt!(RpcTransportError | ProviderDecodeError | ReceiptTimeoutError)!Transport {
  const hashHex = typeof hash === "string" ? hash : Hash.toHex(hash)
  const confirmations = options.confirmations ?? 1
  const pollingInterval = options.pollingInterval ?? "1 second"
  const timeoutDuration = options.timeout ?? "2 minutes"

  const pollLoop = effect {
    while (true) {
      const receiptOpt = try getTransactionReceipt(hashHex)
      if (Option.isSome(receiptOpt)) {
        const receipt = receiptOpt.value
        if (confirmations <= 1) {
          return receipt
        }
        const currentBlock = try getBlockNumber()
        const depth = currentBlock - receipt.blockNumber + 1n
        if (Number(depth) >= confirmations) {
          return receipt
        }
      }
      try sleep(pollingInterval)
    }
  }

  return timeout(pollLoop, timeoutDuration) catch effect (err) => {
    return match (err) {
      when { _tag: "TimeoutError" }: throw new ReceiptTimeoutError({
        hash: hashHex,
        confirmations,
        message: `Timed out waiting for transaction ${hashHex} (${confirmations} confirmation(s))`
      });
      default: throw err;
    }
  }
}

export effect function getLogs(
  filter: LogFilter
): ReadonlyArray<RpcLog>!(RpcTransportError | ProviderDecodeError | InvalidAddressError | InvalidUintError)!Transport {
  const rpcFilter: Record<string, unknown> = {}
  if (filter.address !== undefined) {
    if (Array.isArray(filter.address)) {
      const list: Array<`0x${string}`> = []
      for (const a of filter.address) {
        list.push(try normalizeAddressHex(a))
      }
      rpcFilter["address"] = list
    } else {
      rpcFilter["address"] = try normalizeAddressHex(filter.address as Address.AddressInput)
    }
  }
  if (filter.topics !== undefined) {
    rpcFilter["topics"] = filter.topics
  }
  if (filter.blockHash !== undefined) {
    rpcFilter["blockHash"] = typeof filter.blockHash === "string" ? filter.blockHash : Hash.toHex(filter.blockHash)
  } else {
    if (filter.fromBlock !== undefined) {
      rpcFilter["fromBlock"] = try formatBlockIdentifier(filter.fromBlock)
    }
    if (filter.toBlock !== undefined) {
      rpcFilter["toBlock"] = try formatBlockIdentifier(filter.toBlock)
    }
  }
  const raw = try request<unknown>("eth_getLogs", [rpcFilter])
  if (!Array.isArray(raw)) {
    throw new ProviderDecodeError({ method: "eth_getLogs", message: "Expected array of logs" })
  }
  const out: Array<RpcLog> = []
  for (const item of raw) {
    out.push(try decodeRpcLog(item, "eth_getLogs"))
  }
  return out
}

export effect function sendRawTransaction(
  signedTx: HexType | `0x${string}`
): HashType!(RpcTransportError | InvalidHashError)!Transport {
  const raw = try request<string>("eth_sendRawTransaction", [signedTx])
  return try Hash.fromHex(raw)
}

export effect function simulateCalls(
  payload: Record<string, unknown>,
  block: BlockIdentifier = "latest"
): unknown!(RpcTransportError | InvalidUintError)!Transport {
  const tag = try formatBlockIdentifier(block)
  return try request<unknown>("eth_simulateV1", [payload, tag])
}
