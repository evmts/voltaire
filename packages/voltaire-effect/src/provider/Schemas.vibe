// Typed Ethereum JSON-RPC response models and decoders.

import type { HexType } from "@tevm/voltaire/Hex"
import { errorMessage, ProviderDecodeError } from "../errors.vibe"
import { parseQuantity } from "../primitives/Uint.vibe"

export interface RpcLog {
  readonly address: `0x${string}`
  readonly topics: ReadonlyArray<`0x${string}`>
  readonly data: HexType
  readonly blockNumber: bigint | null
  readonly transactionHash: `0x${string}` | null
  readonly transactionIndex: number | null
  readonly blockHash: `0x${string}` | null
  readonly logIndex: number | null
  readonly removed: boolean
}

export interface RpcBlock {
  readonly number: bigint | null
  readonly hash: `0x${string}` | null
  readonly parentHash: `0x${string}`
  readonly nonce?: `0x${string}` | null
  readonly sha3Uncles?: `0x${string}`
  readonly logsBloom?: `0x${string}` | null
  readonly transactionsRoot?: `0x${string}`
  readonly stateRoot?: `0x${string}`
  readonly receiptsRoot?: `0x${string}`
  readonly miner?: `0x${string}`
  readonly gasLimit: bigint
  readonly gasUsed: bigint
  readonly timestamp: bigint
  readonly baseFeePerGas?: bigint | null
  readonly blobGasUsed?: bigint | null
  readonly excessBlobGas?: bigint | null
  readonly withdrawalsRoot?: `0x${string}` | null
  readonly parentBeaconBlockRoot?: `0x${string}` | null
  readonly transactions: ReadonlyArray<string | RpcTransaction>
}

export interface RpcTransaction {
  readonly hash: `0x${string}`
  readonly nonce: bigint
  readonly blockHash: `0x${string}` | null
  readonly blockNumber: bigint | null
  readonly transactionIndex: number | null
  readonly from: `0x${string}`
  readonly to: `0x${string}` | null
  readonly value: bigint
  readonly gas: bigint
  readonly gasPrice?: bigint | null
  readonly maxFeePerGas?: bigint | null
  readonly maxPriorityFeePerGas?: bigint | null
  readonly maxFeePerBlobGas?: bigint | null
  readonly input: HexType
  readonly type: number
  readonly chainId?: bigint | null
}

export interface RpcTransactionReceipt {
  readonly transactionHash: `0x${string}`
  readonly transactionIndex: number
  readonly blockHash: `0x${string}`
  readonly blockNumber: bigint
  readonly from: `0x${string}`
  readonly to: `0x${string}` | null
  readonly cumulativeGasUsed: bigint
  readonly gasUsed: bigint
  readonly effectiveGasPrice?: bigint | null
  readonly contractAddress: `0x${string}` | null
  readonly logs: ReadonlyArray<RpcLog>
  readonly logsBloom?: `0x${string}`
  readonly status: "success" | "reverted"
  readonly type: number
}

export interface FeeHistory {
  readonly oldestBlock: bigint
  readonly baseFeePerGas: ReadonlyArray<bigint>
  readonly gasUsedRatio: ReadonlyArray<number>
  readonly reward?: ReadonlyArray<ReadonlyArray<bigint>>
}

export interface FeeEstimate {
  readonly type: "eip1559" | "legacy"
  readonly gasPrice?: bigint
  readonly baseFeePerGas?: bigint
  readonly maxFeePerGas?: bigint
  readonly maxPriorityFeePerGas?: bigint
  readonly maxFeePerBlobGas?: bigint
}

effect function decodeQty(raw: unknown, method: string, field: string): bigint!ProviderDecodeError {
  if (typeof raw !== "string" && typeof raw !== "bigint" && typeof raw !== "number") {
    throw new ProviderDecodeError({ method, message: `Expected hex quantity for "${field}"` })
  }
  return parseQuantity(raw) catch effect (e) => {
    throw new ProviderDecodeError({ method, message: `Invalid "${field}": ${e.message}`, cause: e })
  }
}

effect function decodeOptionalQty(raw: unknown, method: string, field: string): (bigint | null)!ProviderDecodeError {
  if (raw === undefined || raw === null) return null
  return try decodeQty(raw, method, field)
}

effect function decodeOptionalNumber(raw: unknown, method: string, field: string): (number | null)!ProviderDecodeError {
  if (raw === undefined || raw === null) return null
  const n = try decodeQty(raw, method, field)
  return Number(n)
}

function asHex(raw: unknown): `0x${string}` {
  return (typeof raw === "string" ? raw : "0x") as `0x${string}`
}

export effect function decodeRpcLog(raw: unknown, method = "eth_getLogs"): RpcLog!ProviderDecodeError {
  if (!Predicate.isObject(raw)) {
    throw new ProviderDecodeError({ method, message: "Expected log object" })
  }
  const obj = raw as Record<string, unknown>
  const topics = Array.isArray(obj["topics"]) ? (obj["topics"] as ReadonlyArray<`0x${string}`>) : []
  return {
    address: asHex(obj["address"]),
    topics,
    data: asHex(obj["data"]) as HexType,
    blockNumber: try decodeOptionalQty(obj["blockNumber"], method, "blockNumber"),
    transactionHash: typeof obj["transactionHash"] === "string" ? (obj["transactionHash"] as `0x${string}`) : null,
    transactionIndex: try decodeOptionalNumber(obj["transactionIndex"], method, "transactionIndex"),
    blockHash: typeof obj["blockHash"] === "string" ? (obj["blockHash"] as `0x${string}`) : null,
    logIndex: try decodeOptionalNumber(obj["logIndex"], method, "logIndex"),
    removed: obj["removed"] === true,
  }
}

export effect function decodeRpcTransaction(
  raw: unknown,
  method = "eth_getTransactionByHash",
): RpcTransaction!ProviderDecodeError {
  if (!Predicate.isObject(raw)) {
    throw new ProviderDecodeError({ method, message: "Expected transaction object" })
  }
  const obj = raw as Record<string, unknown>
  const typeVal = obj["type"] !== undefined && obj["type"] !== null
    ? Number(try decodeQty(obj["type"], method, "type"))
    : 0

  return {
    hash: asHex(obj["hash"]),
    nonce: try decodeQty(obj["nonce"] ?? "0x0", method, "nonce"),
    blockHash: typeof obj["blockHash"] === "string" ? (obj["blockHash"] as `0x${string}`) : null,
    blockNumber: try decodeOptionalQty(obj["blockNumber"], method, "blockNumber"),
    transactionIndex: try decodeOptionalNumber(obj["transactionIndex"], method, "transactionIndex"),
    from: asHex(obj["from"]),
    to: typeof obj["to"] === "string" ? (obj["to"] as `0x${string}`) : null,
    value: try decodeQty(obj["value"] ?? "0x0", method, "value"),
    gas: try decodeQty(obj["gas"] ?? "0x0", method, "gas"),
    gasPrice: try decodeOptionalQty(obj["gasPrice"], method, "gasPrice"),
    maxFeePerGas: try decodeOptionalQty(obj["maxFeePerGas"], method, "maxFeePerGas"),
    maxPriorityFeePerGas: try decodeOptionalQty(obj["maxPriorityFeePerGas"], method, "maxPriorityFeePerGas"),
    maxFeePerBlobGas: try decodeOptionalQty(obj["maxFeePerBlobGas"], method, "maxFeePerBlobGas"),
    input: asHex(obj["input"] ?? obj["data"] ?? "0x") as HexType,
    type: typeVal,
    chainId: try decodeOptionalQty(obj["chainId"], method, "chainId"),
  }
}

export effect function decodeRpcBlock(raw: unknown, method = "eth_getBlockByNumber"): RpcBlock!ProviderDecodeError {
  if (!Predicate.isObject(raw)) {
    throw new ProviderDecodeError({ method, message: "Expected block object" })
  }
  const obj = raw as Record<string, unknown>
  const rawTxs = Array.isArray(obj["transactions"]) ? obj["transactions"] : []
  const txs: Array<string | RpcTransaction> = []
  for (const tx of rawTxs) {
    if (typeof tx === "string") {
      txs.push(tx)
    } else {
      txs.push(try decodeRpcTransaction(tx, method))
    }
  }

  return {
    number: try decodeOptionalQty(obj["number"], method, "number"),
    hash: typeof obj["hash"] === "string" ? (obj["hash"] as `0x${string}`) : null,
    parentHash: asHex(obj["parentHash"]),
    nonce: typeof obj["nonce"] === "string" ? (obj["nonce"] as `0x${string}`) : null,
    sha3Uncles: typeof obj["sha3Uncles"] === "string" ? (obj["sha3Uncles"] as `0x${string}`) : undefined,
    logsBloom: typeof obj["logsBloom"] === "string" ? (obj["logsBloom"] as `0x${string}`) : null,
    transactionsRoot: typeof obj["transactionsRoot"] === "string"
      ? (obj["transactionsRoot"] as `0x${string}`)
      : undefined,
    stateRoot: typeof obj["stateRoot"] === "string" ? (obj["stateRoot"] as `0x${string}`) : undefined,
    receiptsRoot: typeof obj["receiptsRoot"] === "string" ? (obj["receiptsRoot"] as `0x${string}`) : undefined,
    miner: typeof obj["miner"] === "string" ? (obj["miner"] as `0x${string}`) : undefined,
    gasLimit: try decodeQty(obj["gasLimit"] ?? "0x0", method, "gasLimit"),
    gasUsed: try decodeQty(obj["gasUsed"] ?? "0x0", method, "gasUsed"),
    timestamp: try decodeQty(obj["timestamp"] ?? "0x0", method, "timestamp"),
    baseFeePerGas: try decodeOptionalQty(obj["baseFeePerGas"], method, "baseFeePerGas"),
    blobGasUsed: try decodeOptionalQty(obj["blobGasUsed"], method, "blobGasUsed"),
    excessBlobGas: try decodeOptionalQty(obj["excessBlobGas"], method, "excessBlobGas"),
    withdrawalsRoot: typeof obj["withdrawalsRoot"] === "string" ? (obj["withdrawalsRoot"] as `0x${string}`) : null,
    parentBeaconBlockRoot: typeof obj["parentBeaconBlockRoot"] === "string"
      ? (obj["parentBeaconBlockRoot"] as `0x${string}`)
      : null,
    transactions: txs,
  }
}

export effect function decodeRpcReceipt(
  raw: unknown,
  method = "eth_getTransactionReceipt",
): RpcTransactionReceipt!ProviderDecodeError {
  if (!Predicate.isObject(raw)) {
    throw new ProviderDecodeError({ method, message: "Expected receipt object" })
  }
  const obj = raw as Record<string, unknown>
  const rawLogs = Array.isArray(obj["logs"]) ? obj["logs"] : []
  const logs: Array<RpcLog> = []
  for (const log of rawLogs) {
    logs.push(try decodeRpcLog(log, method))
  }
  const rawStatus = obj["status"]
  const status: "success" | "reverted" =
    rawStatus === "0x1" || rawStatus === 1 || rawStatus === "success" || rawStatus === true
      ? "success"
      : "reverted"
  const typeVal = obj["type"] !== undefined && obj["type"] !== null
    ? Number(try decodeQty(obj["type"], method, "type"))
    : 0

  return {
    transactionHash: asHex(obj["transactionHash"]),
    transactionIndex: Number(try decodeQty(obj["transactionIndex"] ?? "0x0", method, "transactionIndex")),
    blockHash: asHex(obj["blockHash"]),
    blockNumber: try decodeQty(obj["blockNumber"] ?? "0x0", method, "blockNumber"),
    from: asHex(obj["from"]),
    to: typeof obj["to"] === "string" ? (obj["to"] as `0x${string}`) : null,
    cumulativeGasUsed: try decodeQty(obj["cumulativeGasUsed"] ?? "0x0", method, "cumulativeGasUsed"),
    gasUsed: try decodeQty(obj["gasUsed"] ?? "0x0", method, "gasUsed"),
    effectiveGasPrice: try decodeOptionalQty(obj["effectiveGasPrice"], method, "effectiveGasPrice"),
    contractAddress: typeof obj["contractAddress"] === "string" ? (obj["contractAddress"] as `0x${string}`) : null,
    logs,
    logsBloom: typeof obj["logsBloom"] === "string" ? (obj["logsBloom"] as `0x${string}`) : undefined,
    status,
    type: typeVal,
  }
}

export effect function decodeFeeHistory(raw: unknown): FeeHistory!ProviderDecodeError {
  if (!Predicate.isObject(raw)) {
    throw new ProviderDecodeError({ method: "eth_feeHistory", message: "Expected feeHistory object" })
  }
  const obj = raw as Record<string, unknown>
  const oldestBlock = try decodeQty(obj["oldestBlock"] ?? "0x0", "eth_feeHistory", "oldestBlock")
  const rawBaseFees = Array.isArray(obj["baseFeePerGas"]) ? obj["baseFeePerGas"] : []
  const baseFeePerGas: Array<bigint> = []
  for (const bf of rawBaseFees) {
    baseFeePerGas.push(try decodeQty(bf, "eth_feeHistory", "baseFeePerGas"))
  }
  const gasUsedRatio = Array.isArray(obj["gasUsedRatio"])
    ? obj["gasUsedRatio"].map((r) => (typeof r === "number" ? r : 0))
    : []

  let reward: Array<ReadonlyArray<bigint>> | undefined = undefined
  if (Array.isArray(obj["reward"])) {
    reward = []
    for (const row of obj["reward"]) {
      const parsedRow: Array<bigint> = []
      if (Array.isArray(row)) {
        for (const item of row) {
          parsedRow.push(try decodeQty(item, "eth_feeHistory", "reward"))
        }
      }
      reward.push(parsedRow)
    }
  }

  return { oldestBlock, baseFeePerGas, gasUsedRatio, reward }
}

export effect function decodeQuantityResult(raw: unknown, method: string): bigint!ProviderDecodeError {
  return decodeQty(raw, method, "result") catch effect (e) => {
    throw new ProviderDecodeError({ method, message: `${method}: ${errorMessage(e)}`, cause: e })
  }
}
