// HTTP JSON-RPC 2.0 Transport built directly on Effect 4 HttpClient.

import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http"
import { errorMessage, RpcError, type RpcTransportError, TransportError, TransportFailureReason } from "../errors.vibe"
import {
  type JsonRpcBatchItemResult,
  JsonRpcBatchItemResult as BatchResult,
  type JsonRpcCall,
  RpcRetry,
  type RpcRetryConfig,
  RpcTimeout,
  Transport,
} from "./Transport.vibe"

export interface HttpTransportConfig {
  readonly url: string
  readonly headers?: Record<string, string>
  readonly timeout?: Duration.Input
  readonly retry?: RpcRetryConfig | false
}

interface RawJsonRpcResponse {
  readonly jsonrpc?: string
  readonly id?: number | string | null
  readonly result?: unknown
  readonly error?: {
    readonly code: number
    readonly message: string
    readonly data?: unknown
  }
}

effect function executeHttpJson(
  client: HttpClient.HttpClient,
  url: string,
  headers: Record<string, string>,
  payload: unknown,
  effectiveTimeout: Duration.Input,
  methodLabel: string,
): unknown!TransportError {
  const req = HttpClientRequest.post(url).pipe(
    HttpClientRequest.setHeaders({
      "content-type": "application/json",
      ...headers,
    }),
    HttpClientRequest.bodyJsonUnsafe(payload),
  )

  const executeAttempt = effect {
    return client.execute(req) catch effect (cause) => {
      throw new TransportError({
        message: `HTTP request to ${url} (${methodLabel}) failed: ${errorMessage(cause)}`,
        reason: TransportFailureReason.Network({ cause }),
        url,
        method: methodLabel,
        cause,
      })
    }
  }

  const response = timeout(executeAttempt, effectiveTimeout) catch effect (err) => {
    return match (err) {
      when TransportError: throw err;
      default: throw new TransportError({
        message: `RPC request to ${url} (${methodLabel}) timed out`,
        reason: TransportFailureReason.Timeout({}),
        url,
        method: methodLabel,
        cause: err,
      });
    }
  }

  if (response.status < 200 || response.status >= 300) {
    const bodyText = response.text catch () => undefined
    throw new TransportError({
      message: `HTTP ${response.status} from ${url} (${methodLabel})`,
      reason: TransportFailureReason.HttpStatus({ status: response.status, body: bodyText }),
      url,
      method: methodLabel,
    })
  }

  return response.json catch effect (cause) => {
    throw new TransportError({
      message: `Invalid JSON response from ${url} (${methodLabel}): ${errorMessage(cause)}`,
      reason: TransportFailureReason.InvalidResponse({ message: errorMessage(cause) }),
      url,
      method: methodLabel,
      cause,
    })
  }
}

effect function withConfiguredRetry<A, E extends RpcTransportError>(
  program: A!E,
  retryConfig: RpcRetryConfig | undefined,
): A!E {
  if (retryConfig === undefined || retryConfig.times <= 0) {
    return try program
  }
  const baseSchedule = Schedule.exponential(retryConfig.baseDelay)
  const schedule = retryConfig.jittered === false ? baseSchedule : Schedule.jittered(baseSchedule)
  return try retry(program, {
    schedule,
    times: retryConfig.times,
    while: (err: E) => err.retryable,
  })
}

// Creates an HTTP Transport layer requiring Effect 4 HttpClient.HttpClient.
export function HttpTransport(options: HttpTransportConfig | string) {
  const config: HttpTransportConfig = typeof options === "string" ? { url: options } : options
  const headers = config.headers ?? {}

  return Layer.effect(
    Transport,
    effect {
      const client = try HttpClient.HttpClient
      const idCounter = try Ref.make(0)

      const nextRequestId = effect {
        return try Ref.updateAndGet(idCounter, (n) => n + 1)
      }

      return Transport.of({
        effect request<T = unknown>(method: string, params?: ReadonlyArray<unknown>): T!RpcTransportError {
          const effectiveTimeout = config.timeout ?? try RpcTimeout
          const effectiveRetry = config.retry === false ? undefined : (config.retry ?? try RpcRetry)

          const attempt = effect {
            const id = try nextRequestId
            const json = try executeHttpJson(
              client,
              config.url,
              headers,
              { jsonrpc: "2.0", id, method, params: params ?? [] },
              effectiveTimeout,
              method,
            )

            if (!Predicate.isObject(json)) {
              throw new TransportError({
                message: `Malformed JSON-RPC response for ${method}`,
                reason: TransportFailureReason.InvalidResponse({ message: "Response is not an object", body: json }),
                url: config.url,
                method,
              })
            }

            const rpc = json as RawJsonRpcResponse
            if (rpc.error !== undefined) {
              throw new RpcError({
                code: rpc.error.code,
                message: rpc.error.message,
                method,
                data: rpc.error.data,
              })
            }
            return rpc.result as T
          }

          return try withConfiguredRetry(attempt, effectiveRetry)
        },

        effect requestBatch(requests: ReadonlyArray<JsonRpcCall>): ReadonlyArray<JsonRpcBatchItemResult>!TransportError {
          if (requests.length === 0) return []
          const effectiveTimeout = config.timeout ?? try RpcTimeout
          const effectiveRetry = config.retry === false ? undefined : (config.retry ?? try RpcRetry)

          const attempt = effect {
            const ids: Array<number> = []
            const payload: Array<
              {
                readonly jsonrpc: "2.0"
                readonly id: number
                readonly method: string
                readonly params: ReadonlyArray<unknown>
              }
            > = []
            for (const req of requests) {
              const id = try nextRequestId
              ids.push(id)
              payload.push({
                jsonrpc: "2.0",
                id,
                method: req.method,
                params: req.params ?? [],
              })
            }

            const json = try executeHttpJson(
              client,
              config.url,
              headers,
              payload,
              effectiveTimeout,
              `batch(${requests.length})`,
            )

            if (!Array.isArray(json)) {
              throw new TransportError({
                message: `Expected JSON-RPC batch array from ${config.url}`,
                reason: TransportFailureReason.InvalidResponse({
                  message: "Batch response is not an array",
                  body: json,
                }),
                url: config.url,
                method: "batch",
              })
            }

            const byId = new Map<number, RawJsonRpcResponse>()
            for (const item of json) {
              if (Predicate.isObject(item) && typeof (item as RawJsonRpcResponse).id === "number") {
                const entry = item as RawJsonRpcResponse
                byId.set(entry.id as number, entry)
              }
            }

            const results: Array<JsonRpcBatchItemResult> = []
            for (let i = 0; i < requests.length; i++) {
              const id = ids[i] ?? 0
              const req = requests[i]
              const item = byId.get(id)
              if (item === undefined) {
                results.push(
                  BatchResult.Err({
                    error: new RpcError({
                      code: -32603,
                      message: `Missing response for batch item id ${id}`,
                      method: req?.method,
                    }),
                  }),
                )
              } else if (item.error !== undefined) {
                results.push(
                  BatchResult.Err({
                    error: new RpcError({
                      code: item.error.code,
                      message: item.error.message,
                      method: req?.method,
                      data: item.error.data,
                    }),
                  }),
                )
              } else {
                results.push(BatchResult.Ok({ value: item.result }))
              }
            }
            return results
          }

          return try withConfiguredRetry(attempt, effectiveRetry)
        },
      })
    },
  )
}

// Zero-ceremony HTTP Transport layer with FetchHttpClient already provided.
export function HttpTransportFetch(options: HttpTransportConfig | string) {
  return Layer.provide(HttpTransport(options), FetchHttpClient.layer)
}
