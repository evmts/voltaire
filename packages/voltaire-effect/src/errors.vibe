// Core tagged errors and failure unions for voltaire-effect.

export data TransportFailureReason {
  HttpStatus { status: number; body?: string }
  Timeout { timeoutMs?: number }
  Network { cause: unknown }
  InvalidResponse { message: string; body?: unknown }
  Disconnected { code?: number; reason?: string }
  Unsupported { message: string }
}

export error TransportError {
  message: string
  reason: TransportFailureReason
  url?: string
  method?: string
  cause?: unknown

  get retryable(): boolean {
    return match (this.reason) {
      when { _tag: "Timeout" }: true;
      when { _tag: "Network" }: true;
      when { _tag: "Disconnected" }: true;
      when { _tag: "HttpStatus", let status }: status === 408 || status === 429 || status >= 500;
      when { _tag: "InvalidResponse" }: false;
      when { _tag: "Unsupported" }: false;
    }
  }
}

export error RpcError {
  code: number
  message: string
  method?: string
  data?: unknown
  cause?: unknown

  get retryable(): boolean {
    return this.code === -32005 || this.code === -32603 || this.code === 429
  }

  get isUserRejected(): boolean {
    return this.code === 4001
  }

  get revertData(): string | undefined {
    if (typeof this.data === "string" && this.data.startsWith("0x")) {
      return this.data
    }
    if (Predicate.isObject(this.data) && "data" in this.data) {
      const inner = (this.data as { readonly data?: unknown }).data
      if (typeof inner === "string" && inner.startsWith("0x")) {
        return inner
      }
    }
    return undefined
  }

  get isRevert(): boolean {
    return this.code === 3 || (this.code === -32000 && this.revertData !== undefined)
  }
}

export type RpcTransportError = TransportError | RpcError

// Primitive and validation errors

export error InvalidAddressError {
  input: unknown
  message: string
  cause?: unknown
}

export error InvalidHexError {
  input: unknown
  message: string
  cause?: unknown
}

export error InvalidHashError {
  input: unknown
  message: string
  cause?: unknown
}

export error InvalidUintError {
  input: unknown
  message: string
  cause?: unknown
}

export error InvalidSignatureError {
  input: unknown
  message: string
  cause?: unknown
}

export error InvalidPrivateKeyError {
  message: string
  cause?: unknown
}

export error InvalidTransactionError {
  message: string
  cause?: unknown
}

export error InvalidUnitError {
  input: unknown
  message: string
  cause?: unknown
}

// ABI & Revert errors

export data RevertReason {
  ErrorString { reason: string }
  Panic { code: bigint; description: string }
  Custom { name: string; signature: string; args: ReadonlyArray<unknown> }
  Raw { data: string }
}

export error AbiEncodeError {
  functionName?: string
  message: string
  cause?: unknown
}

export error AbiDecodeError {
  functionName?: string
  data?: string
  message: string
  cause?: unknown
}

export error AbiItemNotFoundError {
  kind: "function" | "event" | "error" | "constructor"
  name: string
  message: string
}

// Crypto errors

export error CryptoError {
  operation: string
  message: string
  cause?: unknown
}

// Provider & domain errors

export error BlockNotFoundError {
  block: string | bigint
  message: string
}

export error TransactionNotFoundError {
  hash: string
  message: string
}

export error ReceiptTimeoutError {
  hash: string
  confirmations: number
  message: string
}

export error ProviderDecodeError {
  method: string
  message: string
  cause?: unknown
}

export error MulticallError {
  message: string
  failedIndices?: ReadonlyArray<number>
  cause?: unknown
}

export error EnsError {
  name?: string
  address?: string
  message: string
  cause?: unknown
}

export error SiweError {
  message: string
  cause?: unknown
}

// Account & Signer errors

export error AccountError {
  action: string
  message: string
  cause?: unknown
}

export error NonceError {
  address: string
  message: string
  cause?: unknown
}

export error FeeEstimationError {
  message: string
  cause?: unknown
}

export error SignerError {
  action: string
  message: string
  code?: number
  userRejected?: boolean
  cause?: unknown
}

// Contract errors

export error ContractRevertError {
  address: string
  method: string
  reason: RevertReason
  rawData: string
  message: string
}

export error ContractCallError {
  address: string
  method: string
  message: string
  cause?: unknown
}

export error ContractWriteError {
  address: string
  method: string
  message: string
  cause?: unknown
}

export error ContractEventError {
  address: string
  event: string
  message: string
  cause?: unknown
}

// Stream & Rate limit errors

export error StreamError {
  stream: string
  message: string
  cause?: unknown
}

export error RateLimitError {
  message: string
  retryAfterMs?: number
}

export function errorMessage(cause: unknown): string {
  if (cause instanceof Error) return cause.message
  if (Predicate.isObject(cause) && "message" in cause && typeof (cause as { readonly message?: unknown }).message === "string") {
    return (cause as { readonly message: string }).message
  }
  return String(cause)
}
