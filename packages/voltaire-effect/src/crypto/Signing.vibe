// EIP-191 personal message signing/verification, constant-time compare, and ERC-6492 wrapping.

import type { AddressType } from "@tevm/voltaire/Address"
import type { HashType } from "@tevm/voltaire/Hash"
import type { HexType } from "@tevm/voltaire/Hex"
import type { Secp256k1SignatureType } from "@tevm/voltaire/Secp256k1"
import { CryptoError, errorMessage, InvalidAddressError } from "../errors.vibe"
import * as Abi from "../primitives/Abi.vibe"
import * as Address from "../primitives/Address.vibe"
import * as Hex from "../primitives/Hex.vibe"
import { Keccak } from "./Keccak.vibe"
import { Secp256k1 } from "./Secp256k1.vibe"

// ERC-6492 magic suffix (32 bytes): 0x6492649264926492649264926492649264926492649264926492649264926492
export const ERC6492_MAGIC_BYTES = "0x6492649264926492649264926492649264926492649264926492649264926492" as HexType

module native {
  /** @throws {never} */
  export function utf8ToBytes(value: string): Uint8Array {
    return new TextEncoder().encode(value)
  }
}

import { utf8ToBytes } from native

// Constant-time equality over byte arrays to avoid timing leaks.
export function constantTimeEqual(a: Uint8Array, b: Uint8Array): boolean {
  if (a.length !== b.length) return false
  let diff = 0
  for (let i = 0; i < a.length; i++) {
    diff |= (a[i] ?? 0) ^ (b[i] ?? 0)
  }
  return diff === 0
}

// EIP-191 personal_sign digest: keccak256("\x19Ethereum Signed Message:\n" + len + message)
export effect function hashMessage(message: string | Uint8Array): HashType!CryptoError!Keccak {
  const payload = typeof message === "string" ? utf8ToBytes(message) : message
  const prefix = utf8ToBytes(`\x19Ethereum Signed Message:\n${payload.length}`)
  const combined = new Uint8Array(prefix.length + payload.length)
  combined.set(prefix, 0)
  combined.set(payload, prefix.length)
  return try (try Keccak).hash(combined)
}

export effect function signMessage(
  message: string | Uint8Array,
  privateKey: Uint8Array,
): Secp256k1SignatureType!CryptoError!(Keccak | Secp256k1) {
  const digest = try hashMessage(message)
  return try (try Secp256k1).sign(digest, privateKey)
}

export effect function recoverMessageAddress(
  message: string | Uint8Array,
  signature: Secp256k1SignatureType,
): AddressType!CryptoError!(Keccak | Secp256k1) {
  const digest = try hashMessage(message)
  return try (try Secp256k1).recoverAddress(signature, digest)
}

export effect function verifyMessage(
  message: string | Uint8Array,
  signature: Secp256k1SignatureType,
  expectedAddress: Address.AddressInput,
): boolean!(CryptoError | InvalidAddressError)!(Keccak | Secp256k1) {
  const expected = typeof expectedAddress === "string" ? try Address.fromHex(expectedAddress) : expectedAddress
  const recovered = try recoverMessageAddress(message, signature)
  return constantTimeEqual(Address.toBytes(recovered), Address.toBytes(expected))
}

export interface Erc6492Payload {
  readonly factory: AddressType
  readonly factoryCalldata: HexType
  readonly signature: HexType
}

export function isErc6492Signature(signature: string): boolean {
  return signature.toLowerCase().endsWith(ERC6492_MAGIC_BYTES.slice(2))
}

export effect function wrapErc6492Signature(params: {
  readonly factory: Address.AddressInput
  readonly factoryCalldata: HexType | string
  readonly signature: HexType | string
}): HexType!CryptoError {
  const factoryAddr = typeof params.factory === "string"
    ? Address.fromHex(params.factory) catch effect (e) => {
      throw new CryptoError({ operation: "erc6492.wrap", message: e.message, cause: e })
    }
    : params.factory
  const calldataHex = Hex.from(params.factoryCalldata) catch effect (e) => {
    throw new CryptoError({ operation: "erc6492.wrap", message: e.message, cause: e })
  }
  const sigHex = Hex.from(params.signature) catch effect (e) => {
    throw new CryptoError({ operation: "erc6492.wrap", message: e.message, cause: e })
  }
  const encoded = Abi.encodeParameters(
    [
      { type: "address", name: "factory" },
      { type: "bytes", name: "factoryCalldata" },
      { type: "bytes", name: "signature" },
    ],
    [Address.toHex(factoryAddr), calldataHex, sigHex],
  ) catch effect (e) => {
    throw new CryptoError({ operation: "erc6492.wrap", message: `ERC-6492 wrap failed: ${errorMessage(e)}`, cause: e })
  }
  return `${encoded}${ERC6492_MAGIC_BYTES.slice(2)}` as HexType
}

export effect function unwrapErc6492Signature(signature: HexType | string): Erc6492Payload!CryptoError {
  const hex = Hex.from(signature) catch effect (e) => {
    throw new CryptoError({ operation: "erc6492.unwrap", message: e.message, cause: e })
  }
  if (!isErc6492Signature(hex)) {
    throw new CryptoError({ operation: "erc6492.unwrap", message: "Signature does not end with ERC-6492 magic bytes" })
  }
  const bodyHex = hex.slice(0, hex.length - 64) as HexType
  const decoded = Abi.decodeParameters(
    [
      { type: "address", name: "factory" },
      { type: "bytes", name: "factoryCalldata" },
      { type: "bytes", name: "signature" },
    ],
    bodyHex,
  ) catch effect (e) => {
    throw new CryptoError({
      operation: "erc6492.unwrap",
      message: `ERC-6492 unwrap failed: ${errorMessage(e)}`,
      cause: e,
    })
  }
  const factoryVal = decoded[0]
  const factoryAddr = Address.from(factoryVal as string | Uint8Array) catch effect (e) => {
    throw new CryptoError({ operation: "erc6492.unwrap", message: e.message, cause: e })
  }
  const calldataRaw = decoded[1]
  const sigRaw = decoded[2]
  const factoryCalldata = Hex.from(calldataRaw as string | Uint8Array) catch effect (e) => {
    throw new CryptoError({ operation: "erc6492.unwrap", message: e.message, cause: e })
  }
  const innerSig = Hex.from(sigRaw as string | Uint8Array) catch effect (e) => {
    throw new CryptoError({ operation: "erc6492.unwrap", message: e.message, cause: e })
  }
  return { factory: factoryAddr, factoryCalldata, signature: innerSig }
}
