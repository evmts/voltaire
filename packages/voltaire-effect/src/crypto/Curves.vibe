// Curve & symmetric crypto services: P-256 (EIP-7951), Ed25519, and AES-GCM.

import { CryptoError, errorMessage } from "../errors.vibe"

export interface P256Signature {
  readonly r: Uint8Array
  readonly s: Uint8Array
}

module native {
  import * as VoltaireP256 from "@tevm/voltaire/P256"
  import * as VoltaireEd25519 from "@tevm/voltaire/Ed25519"
  import * as VoltaireAesGcm from "@tevm/voltaire/AesGcm"
  import type { P256Signature } from "./Curves.vibe"

  export function p256SignRaw(messageHash: Uint8Array, privateKey: Uint8Array): P256Signature {
    return VoltaireP256.sign(messageHash as any, privateKey as any)
  }

  export function p256VerifyRaw(sig: P256Signature, messageHash: Uint8Array, publicKey: Uint8Array): boolean {
    return VoltaireP256.verify(sig as any, messageHash as any, publicKey as any)
  }

  export function p256DerivePublicKeyRaw(privateKey: Uint8Array): Uint8Array {
    return VoltaireP256.derivePublicKey(privateKey as any)
  }

  export function ed25519KeypairFromSeedRaw(seed: Uint8Array): { readonly publicKey: Uint8Array; readonly secretKey: Uint8Array } {
    return VoltaireEd25519.keypairFromSeed(seed as any)
  }

  export function ed25519SignRaw(message: Uint8Array, secretKey: Uint8Array): Uint8Array {
    return VoltaireEd25519.sign(message, secretKey as any)
  }

  export function ed25519VerifyRaw(signature: Uint8Array, message: Uint8Array, publicKey: Uint8Array): boolean {
    return VoltaireEd25519.verify(signature as any, message, publicKey as any)
  }

  export async function aesImportKeyRaw(rawKey: Uint8Array): Promise<CryptoKey> {
    return VoltaireAesGcm.importKey(rawKey)
  }

  export async function aesEncryptRaw(
    plaintext: Uint8Array,
    key: CryptoKey,
    nonce: Uint8Array,
    additionalData?: Uint8Array
  ): Promise<Uint8Array> {
    return VoltaireAesGcm.encrypt(plaintext, key, nonce, additionalData)
  }

  export async function aesDecryptRaw(
    ciphertext: Uint8Array,
    key: CryptoKey,
    nonce: Uint8Array,
    additionalData?: Uint8Array
  ): Promise<Uint8Array> {
    return VoltaireAesGcm.decrypt(ciphertext, key, nonce, additionalData)
  }
}

import {
  aesDecryptRaw,
  aesEncryptRaw,
  aesImportKeyRaw,
  ed25519KeypairFromSeedRaw,
  ed25519SignRaw,
  ed25519VerifyRaw,
  p256DerivePublicKeyRaw,
  p256SignRaw,
  p256VerifyRaw
} from native

export service P256 {
  static readonly key = "voltaire-effect/crypto/P256"
  sign(messageHash: Uint8Array, privateKey: Uint8Array): P256Signature!CryptoError
  verify(signature: P256Signature, messageHash: Uint8Array, publicKey: Uint8Array): boolean!CryptoError
  derivePublicKey(privateKey: Uint8Array): Uint8Array!CryptoError
}

export service Ed25519 {
  static readonly key = "voltaire-effect/crypto/Ed25519"
  keypairFromSeed(seed: Uint8Array): { readonly publicKey: Uint8Array; readonly secretKey: Uint8Array }!CryptoError
  sign(message: Uint8Array, secretKey: Uint8Array): Uint8Array!CryptoError
  verify(signature: Uint8Array, message: Uint8Array, publicKey: Uint8Array): boolean!CryptoError
}

export service AesGcm {
  static readonly key = "voltaire-effect/crypto/AesGcm"
  encrypt(plaintext: Uint8Array, rawKey: Uint8Array, nonce: Uint8Array, additionalData?: Uint8Array): Uint8Array!CryptoError
  decrypt(ciphertext: Uint8Array, rawKey: Uint8Array, nonce: Uint8Array, additionalData?: Uint8Array): Uint8Array!CryptoError
}

export const P256Live = Layer.succeed(P256, {
  effect sign(messageHash: Uint8Array, privateKey: Uint8Array) {
    return try Effect.try({
      try: () => p256SignRaw(messageHash, privateKey),
      catch: (cause) => new CryptoError({ operation: "p256.sign", message: `P-256 sign failed: ${errorMessage(cause)}`, cause })
    })
  },
  effect verify(signature: P256Signature, messageHash: Uint8Array, publicKey: Uint8Array) {
    return try Effect.try({
      try: () => p256VerifyRaw(signature, messageHash, publicKey),
      catch: (cause) => new CryptoError({ operation: "p256.verify", message: `P-256 verify failed: ${errorMessage(cause)}`, cause })
    })
  },
  effect derivePublicKey(privateKey: Uint8Array) {
    return try Effect.try({
      try: () => p256DerivePublicKeyRaw(privateKey),
      catch: (cause) => new CryptoError({ operation: "p256.derivePublicKey", message: `P-256 public key derivation failed: ${errorMessage(cause)}`, cause })
    })
  }
})

export const Ed25519Live = Layer.succeed(Ed25519, {
  effect keypairFromSeed(seed: Uint8Array) {
    return try Effect.try({
      try: () => ed25519KeypairFromSeedRaw(seed),
      catch: (cause) => new CryptoError({ operation: "ed25519.keypairFromSeed", message: `Ed25519 keypair derivation failed: ${errorMessage(cause)}`, cause })
    })
  },
  effect sign(message: Uint8Array, secretKey: Uint8Array) {
    return try Effect.try({
      try: () => ed25519SignRaw(message, secretKey),
      catch: (cause) => new CryptoError({ operation: "ed25519.sign", message: `Ed25519 sign failed: ${errorMessage(cause)}`, cause })
    })
  },
  effect verify(signature: Uint8Array, message: Uint8Array, publicKey: Uint8Array) {
    return try Effect.try({
      try: () => ed25519VerifyRaw(signature, message, publicKey),
      catch: (cause) => new CryptoError({ operation: "ed25519.verify", message: `Ed25519 verify failed: ${errorMessage(cause)}`, cause })
    })
  }
})

export const AesGcmLive = Layer.succeed(AesGcm, {
  effect encrypt(plaintext: Uint8Array, rawKey: Uint8Array, nonce: Uint8Array, additionalData?: Uint8Array) {
    return try tryPromise({
      try: async () => {
        const key = await aesImportKeyRaw(rawKey)
        return aesEncryptRaw(plaintext, key, nonce, additionalData)
      },
      catch: (cause) => new CryptoError({ operation: "aesGcm.encrypt", message: `AES-GCM encrypt failed: ${errorMessage(cause)}`, cause })
    })
  },
  effect decrypt(ciphertext: Uint8Array, rawKey: Uint8Array, nonce: Uint8Array, additionalData?: Uint8Array) {
    return try tryPromise({
      try: async () => {
        const key = await aesImportKeyRaw(rawKey)
        return aesDecryptRaw(ciphertext, key, nonce, additionalData)
      },
      catch: (cause) => new CryptoError({ operation: "aesGcm.decrypt", message: `AES-GCM decrypt failed: ${errorMessage(cause)}`, cause })
    })
  }
})
