export const ERC165_ABI = [
  {
    type: "function",
    name: "supportsInterface",
    stateMutability: "view",
    inputs: [{ name: "interfaceId", type: "bytes4" }],
    outputs: [{ name: "", type: "bool" }],
  },
] as const

export const INTERFACE_IDS = {
  ERC165: "0x01ffc9a7" as HexType,
  ERC721: "0x80ac58cd" as HexType,
  ERC721Metadata: "0x5b5e139f" as HexType,
  ERC1155: "0xd9b67a26" as HexType,
  ERC2981: "0x2a55205a" as HexType,
} as const

export effect function erc20BalanceOf(
  token: AddressInput,
  account: AddressInput,
  options?: ReadOptions,
): bigint!(InvalidAddressError | ContractCallError | ContractRevertError)!Transport {
  const contract = try Contract(token, ERC20_ABI)
  return try contract.read.balanceOf(account, options)
}

export effect function erc20Transfer(
  token: AddressInput,
  to: AddressInput,
  amount: bigint,
  options?: WriteOptions,
): HashType!(InvalidAddressError | ContractWriteError)!Signer {
  const contract = try Contract(token, ERC20_ABI)
  return try contract.write.transfer(to, amount, options)
}

export effect function erc721OwnerOf(
  nft: AddressInput,
  tokenId: bigint,
  options?: ReadOptions,
): `0x${string}`!(InvalidAddressError | ContractCallError | ContractRevertError)!Transport {
  const contract = try Contract(nft, ERC721_ABI)
  return try contract.read.ownerOf(tokenId, options)
}

export effect function supportsInterface(
  address: AddressInput,
  interfaceId: HexType | `0x${string}`,
  options?: ReadOptions,
): boolean!(InvalidAddressError | ContractCallError | ContractRevertError)!Transport {
  const contract = try Contract(address, ERC165_ABI)
  return try contract.read.supportsInterface(interfaceId, options)
}
