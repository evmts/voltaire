// Canonical ERC-20, ERC-721, ERC-1155, and ERC-165 ABIs and typed Effect helpers.

import type { HashType } from "@tevm/voltaire/Hash"
import type { HexType } from "@tevm/voltaire/Hex"
import { Contract } from "../contract/Contract.vibe"
import type { ReadOptions, WriteOptions } from "../contract/types.vibe"
import { ContractCallError, ContractRevertError, ContractWriteError, InvalidAddressError } from "../errors.vibe"
import type { AddressInput } from "../primitives/Address.vibe"
import { Signer } from "../signer/Signer.vibe"
import { Transport } from "../transport/Transport.vibe"

export const ERC20_ABI = [
  { type: "function", name: "name", stateMutability: "view", inputs: [], outputs: [{ name: "", type: "string" }] },
  { type: "function", name: "symbol", stateMutability: "view", inputs: [], outputs: [{ name: "", type: "string" }] },
