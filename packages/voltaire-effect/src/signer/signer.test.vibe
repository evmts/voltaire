import { assert, describe, it } from "@effect/vitest"
import * as Address from "../primitives/Address.vibe"
import * as Hash from "../primitives/Hash.vibe"
import * as Transaction from "../primitives/Transaction.vibe"
import { TestProvider } from "../provider/Providers.vibe"
import {
  Account,
  LocalAccount,
  MnemonicAccount,
  NonceManager,
  NonceManagerLive,
  Signer,
  SignerFromPrivateKey,
} from "./index.vibe"

const TEST_PRIVATE_KEY = "0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80" as const
const TEST_ADDRESS = "0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266" as const
const RECIPIENT = "0x70997970c51812dc3a010c7d01b50e0d17dc79c8" as const
const TEST_MNEMONIC = "test test test test test test test test test test test junk"
const FAKE_TX_HASH = "0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" as const

describe("signer", () => {
  it.effect("LocalAccount and MnemonicAccount derive the same address and sign EIP-7702 authorizations", effect () => {
    provide LocalAccount(TEST_PRIVATE_KEY) {
      const local = try Account
      try Effect.try(() => assert.strictEqual(String(Address.toHex(local.address)), TEST_ADDRESS))
      const auth = try local.signAuthorization({
        chainId: 1n,
        address: RECIPIENT,
        nonce: 0n,
      })
      try Effect.try(() => assert.strictEqual(auth.chainId, 1n))
      try Effect.try(() => assert.strictEqual(String(auth.address), RECIPIENT))
      try Effect.try(() => assert.strictEqual(auth.yParity === 0 || auth.yParity === 1, true))
    }

    provide MnemonicAccount(TEST_MNEMONIC) {
      const mn = try Account
      try Effect.try(() => assert.strictEqual(String(Address.toHex(mn.address)), TEST_ADDRESS))
    }
  })

  it.effect("NonceManager allocates strictly unique sequential nonces under concurrency", effect () => {
    const provider = TestProvider({
      eth_getTransactionCount: "0xa", // 10
    })

    provide Layer.provide(NonceManagerLive, provider) {
      const nm = try NonceManager
      const nonces = try.all [
        nm.nextNonce(TEST_ADDRESS),
        nm.nextNonce(TEST_ADDRESS),
        nm.nextNonce(TEST_ADDRESS),
        nm.nextNonce(TEST_ADDRESS),
        nm.nextNonce(TEST_ADDRESS),
      ]
      const sorted = [...nonces].sort((a, b) => (a < b ? -1 : a > b ? 1 : 0))
      try Effect.try(() => assert.deepStrictEqual(sorted, [10n, 11n, 12n, 13n, 14n]))

      try nm.reset(TEST_ADDRESS)
      const afterReset = try nm.nextNonce(TEST_ADDRESS)
      try Effect.try(() => assert.strictEqual(afterReset, 10n))
    }
  })

  it.effect("Signer signs real EIP-1559 transaction whose deserialized sender recovers to signer address", effect () => {
    const sentRawTxs: Array<string> = []
    const provider = TestProvider({
      eth_chainId: "0x1",
      eth_getTransactionCount: "0x5",
      eth_estimateGas: "0x5208",
      eth_maxPriorityFeePerGas: "0x3b9aca00",
      eth_blobBaseFee: "0x3b9aca00",
      eth_getBlockByNumber: {
        number: "0x100",
        hash: FAKE_TX_HASH,
        parentHash: FAKE_TX_HASH,
        gasLimit: "0x1c9c380",
        gasUsed: "0x5208",
        timestamp: "0x67000000",
        baseFeePerGas: "0x2540be400",
        transactions: [],
      },
      eth_sendRawTransaction: (params) => {
        sentRawTxs.push(String(params[0]))
        return FAKE_TX_HASH
      },
    })

    const signerLayer = Layer.provide(SignerFromPrivateKey(TEST_PRIVATE_KEY), provider)

    provide signerLayer {
      const signer = try Signer
      const signedHex = try signer.signTransaction({
        to: RECIPIENT,
        value: 1000000000000000000n,
      })
      const decoded = try Transaction.deserialize(signedHex)
      const recoveredSender = try Transaction.getSender(decoded)
      try Effect.try(() => assert.strictEqual(String(Address.toHex(recoveredSender)), TEST_ADDRESS))
      try Effect.try(() => assert.strictEqual(decoded.nonce, 5n))

      // Second tx uses NonceManager -> nonce 6 automatically!
      const txHash = try signer.sendTransaction({
        to: RECIPIENT,
        value: 500n,
      })
      try Effect.try(() => assert.strictEqual(String(Hash.toHex(txHash)), FAKE_TX_HASH))
      try Effect.try(() => assert.strictEqual(sentRawTxs.length, 1))
      const sentDecoded = try Transaction.deserialize(sentRawTxs[0] as `0x${string}`)
      try Effect.try(() => assert.strictEqual(sentDecoded.nonce, 6n))
    }
  })
})
