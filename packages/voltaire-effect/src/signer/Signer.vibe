// High-level Signer service with concurrent transaction preparation (try.all),
// atomic NonceManager integration, all 5 EIP tx types, EIP-7702 authorizations, and contract deployment.

import type { AddressType } from "@tevm/voltaire/Address"
import type { HashType } from "@tevm/voltaire/Hash"
import type { HexType } from "@tevm/voltaire/Hex"
import type { SignatureType } from "@tevm/voltaire/Signature"
import type { Eip712 as Eip712Ns } from "../crypto/index.vibe"
import { errorMessage, RpcError, SignerError } from "../errors.vibe"
import * as Abi from "../primitives/Abi.vibe"
import * as Address from "../primitives/Address.vibe"
import * as Hex from "../primitives/Hex.vibe"
import * as Signature from "../primitives/Signature.vibe"
import * as Transaction from "../primitives/Transaction.vibe"
import {
  estimateFeesPerGas,
  estimateGas,
  getChainId,
  getTransactionCount,
  sendRawTransaction,
  waitForTransactionReceipt,
  type WaitForReceiptOptions
} from "../provider/Actions.vibe"
import type { RpcTransactionReceipt } from "../provider/Schemas.vibe"
import { Transport } from "../transport/Transport.vibe"
import {
  type AccessListEntry,
  Account,
  LocalAccount,
  MnemonicAccount,
  type SignableTransaction,
  type SignedAuthorization
} from "./Account.vibe"
import { NonceManager, NonceManagerLive } from "./NonceManager.vibe"

export interface TransactionRequest {
  readonly type?: 0 | 1 | 2 | 3 | 4
  readonly to?: Address.AddressInput | null
  readonly value?: bigint
  readonly data?: HexType | `0x${string}`
  readonly nonce?: bigint
  readonly chainId?: bigint
  readonly gasLimit?: bigint
  readonly gasPrice?: bigint
  readonly maxFeePerGas?: bigint
  readonly maxPriorityFeePerGas?: bigint
  readonly maxFeePerBlobGas?: bigint
  readonly blobVersionedHashes?: ReadonlyArray<`0x${string}`>
  readonly accessList?: ReadonlyArray<AccessListEntry>
  readonly authorizationList?: ReadonlyArray<SignedAuthorization>
}

export interface DeployContractParams {
  readonly abi: Abi.Abi
  readonly bytecode: HexType | `0x${string}`
  readonly args?: ReadonlyArray<unknown>
  readonly value?: bigint
  readonly gasLimit?: bigint
  readonly nonce?: bigint
}

export interface PrepareAuthorizationParams {
  readonly contractAddress: Address.AddressInput
  readonly chainId?: bigint
  readonly nonce?: bigint
}

module native {
  import * as VoltaireTx from "@tevm/voltaire/Transaction"
  import { Address as VoltaireAddress } from "@tevm/voltaire/Address"
  import * as VoltaireHash from "@tevm/voltaire/Hash"
  import * as VoltaireHex from "@tevm/voltaire/Hex"
  import type { SignableTransaction } from "./Account.vibe"

  export function buildSignedTx(
    tx: SignableTransaction,
    yParity: number,
    r: Uint8Array,
    s: Uint8Array
  ): VoltaireTx.Any {
    const accessList = (tx.accessList ?? []).map((entry) => ({
      address: typeof entry.address === "string" ? VoltaireAddress.fromHex(entry.address) : entry.address,
      storageKeys: entry.storageKeys.map((k) => VoltaireHash.fromHex(k))
    }))

    switch (tx.type) {
      case 0:
        return {
          type: VoltaireTx.Type.Legacy,
          nonce: tx.nonce,
          gasPrice: tx.gasPrice ?? 0n,
          gasLimit: tx.gasLimit,
          to: tx.to,
          value: tx.value,
          data: tx.data,
          v: tx.chainId * 2n + 35n + BigInt(yParity),
          r,
          s
        }
      case 1:
        return {
          type: VoltaireTx.Type.EIP2930,
          chainId: tx.chainId,
          nonce: tx.nonce,
          gasPrice: tx.gasPrice ?? 0n,
          gasLimit: tx.gasLimit,
          to: tx.to,
          value: tx.value,
          data: tx.data,
          accessList,
          yParity,
          r,
          s
        }
      case 2:
        return {
          type: VoltaireTx.Type.EIP1559,
          chainId: tx.chainId,
          nonce: tx.nonce,
          maxPriorityFeePerGas: tx.maxPriorityFeePerGas ?? 0n,
          maxFeePerGas: tx.maxFeePerGas ?? 0n,
          gasLimit: tx.gasLimit,
          to: tx.to,
          value: tx.value,
          data: tx.data,
          accessList,
          yParity,
          r,
          s
        }
      case 3:
        if (!tx.to) throw new Error("EIP-4844 transactions require a 'to' address")
        return {
          type: VoltaireTx.Type.EIP4844,
          chainId: tx.chainId,
          nonce: tx.nonce,
          maxPriorityFeePerGas: tx.maxPriorityFeePerGas ?? 0n,
          maxFeePerGas: tx.maxFeePerGas ?? 0n,
          gasLimit: tx.gasLimit,
          to: tx.to,
          value: tx.value,
          data: tx.data,
          accessList,
          maxFeePerBlobGas: tx.maxFeePerBlobGas ?? 0n,
          blobVersionedHashes: (tx.blobVersionedHashes ?? []).map((h) => VoltaireHash.fromHex(h)),
          yParity,
          r,
          s
        }
      case 4:
        return {
          type: VoltaireTx.Type.EIP7702,
          chainId: tx.chainId,
          nonce: tx.nonce,
          maxPriorityFeePerGas: tx.maxPriorityFeePerGas ?? 0n,
          maxFeePerGas: tx.maxFeePerGas ?? 0n,
          gasLimit: tx.gasLimit,
          to: tx.to,
          value: tx.value,
          data: tx.data,
          accessList,
          authorizationList: (tx.authorizationList ?? []).map((a) => ({
            chainId: a.chainId,
            address: VoltaireAddress.fromHex(a.address),
            nonce: a.nonce,
            yParity: a.yParity,
            r: VoltaireHex.toBytes(a.r),
            s: VoltaireHex.toBytes(a.s)
          })),
          yParity,
          r,
          s
        }
    }
  }
}

import { buildSignedTx } from native

function detectTxType(tx: TransactionRequest, supportsEip1559: boolean): 0 | 1 | 2 | 3 | 4 {
  if (tx.type !== undefined) return tx.type
  if (tx.authorizationList !== undefined) return 4
  if (tx.blobVersionedHashes !== undefined || tx.maxFeePerBlobGas !== undefined) return 3
  if (tx.maxFeePerGas !== undefined || tx.maxPriorityFeePerGas !== undefined) return 2
  if (tx.accessList !== undefined && tx.gasPrice !== undefined) return 1
  if (tx.gasPrice !== undefined) return 0
  return supportsEip1559 ? 2 : 0
}

function toSignerError(action: string, cause: unknown): SignerError {
  if (cause instanceof SignerError) return cause
  const code = cause instanceof RpcError ? cause.code : undefined
  const userRejected = cause instanceof RpcError ? cause.isUserRejected : undefined
  return new SignerError({
    action,
    message: `${action} failed: ${errorMessage(cause)}`,
    code,
    userRejected,
    cause
  })
}

export service Signer {
  static readonly key = "voltaire-effect/signer/Signer"
  readonly address: AddressType
  signMessage(message: string | Uint8Array): SignatureType!SignerError
  signTypedData(typedData: Eip712Ns.Eip712TypedDataInput): SignatureType!SignerError
  prepareTransaction(tx: TransactionRequest): SignableTransaction!SignerError
  signTransaction(tx: TransactionRequest): HexType!SignerError
  sendTransaction(tx: TransactionRequest): HashType!SignerError
  sendTransactionAndWait(
    tx: TransactionRequest,
    waitOptions?: WaitForReceiptOptions
  ): { readonly hash: HashType; readonly receipt: RpcTransactionReceipt }!SignerError
  prepareAuthorization(params: PrepareAuthorizationParams): SignedAuthorization!SignerError
  deployContract(params: DeployContractParams): HashType!SignerError
}

export const SignerLive = Layer.effect(
  Signer,
  effect {
    const account = try Account
    const transport = try Transport
    const nonceManagerOpt = try Effect.serviceOption(NonceManager)
    const fromHex = Address.toHex(account.address)

    effect function resolveNonce(explicitNonce: bigint | undefined): bigint!SignerError {
      if (explicitNonce !== undefined) return explicitNonce
      if (Option.isSome(nonceManagerOpt)) {
        return nonceManagerOpt.value.nextNonce(account.address) catch effect (e) => {
          throw toSignerError("resolveNonce", e)
        }
      }
      return Effect.provideService(
        getTransactionCount(fromHex, "pending"),
        Transport,
        transport
      ) catch effect (e) => {
        throw toSignerError("resolveNonce", e)
      }
    }

    // Concurrently populates nonce, chainId, gasLimit, and EIP-1559/legacy fees in ONE parallel roundtrip!
    effect function prepareTx(tx: TransactionRequest): SignableTransaction!SignerError {
      const toAddress: AddressType | null = tx.to !== undefined && tx.to !== null
        ? typeof tx.to === "string"
          ? Address.fromHex(tx.to) catch effect (e) => {
              throw toSignerError("prepareTransaction", e)
            }
          : tx.to
        : null
      const toHex = toAddress !== null ? Address.toHex(toAddress) : undefined
      const dataBytes = tx.data !== undefined
        ? Hex.toBytes(tx.data) catch effect (e) => {
            throw toSignerError("prepareTransaction", e)
          }
        : new Uint8Array(0)

      const needFees = tx.gasPrice === undefined && (tx.maxFeePerGas === undefined || tx.maxPriorityFeePerGas === undefined)

      const [nonce, chainId, gasLimit, feeEstimate] = try.all [
        resolveNonce(tx.nonce),
        effect {
          if (tx.chainId !== undefined) return tx.chainId
          return Effect.provideService(getChainId(), Transport, transport) catch effect (e) => {
            throw toSignerError("prepareTransaction", e)
          }
        },
        effect {
          if (tx.gasLimit !== undefined) return tx.gasLimit
          return Effect.provideService(
            estimateGas({
              from: fromHex,
              to: toHex,
              data: tx.data,
              value: tx.value
            }),
            Transport,
            transport
          ) catch effect (e) => {
            throw toSignerError("prepareTransaction", e)
          }
        },
        effect {
          if (!needFees) return undefined
          return Effect.provideService(estimateFeesPerGas(), Transport, transport) catch effect (e) => {
            throw toSignerError("prepareTransaction", e)
          }
        }
      ]

      const supportsEip1559 = feeEstimate !== undefined ? feeEstimate.type === "eip1559" : tx.gasPrice === undefined
      const txType = detectTxType(tx, supportsEip1559)

      const gasPrice = txType === 0 || txType === 1
        ? tx.gasPrice ?? feeEstimate?.gasPrice ?? feeEstimate?.maxFeePerGas ?? 0n
        : undefined
      const maxPriorityFeePerGas = txType >= 2
        ? tx.maxPriorityFeePerGas ?? feeEstimate?.maxPriorityFeePerGas ?? 1500000000n
        : undefined
      const maxFeePerGas = txType >= 2
        ? tx.maxFeePerGas ?? feeEstimate?.maxFeePerGas ?? 0n
        : undefined
      const maxFeePerBlobGas = txType === 3
        ? tx.maxFeePerBlobGas ?? feeEstimate?.maxFeePerBlobGas
        : undefined

      return {
        type: txType,
        nonce,
        chainId,
        gasLimit,
        to: toAddress,
        value: tx.value ?? 0n,
        data: dataBytes,
        gasPrice,
        maxFeePerGas,
        maxPriorityFeePerGas,
        maxFeePerBlobGas,
        blobVersionedHashes: tx.blobVersionedHashes,
        accessList: tx.accessList,
        authorizationList: tx.authorizationList
      }
    }

    effect function signTx(tx: TransactionRequest): HexType!SignerError {
      const prepared = try prepareTx(tx)
      const sig = account.signTransaction(prepared) catch effect (e) => {
        throw toSignerError("signTransaction", e)
      }
      const [yParity, r, s] = Signature.toTuple(sig) catch effect (e) => {
        throw toSignerError("signTransaction", e)
      }
      const fullTx = try Effect.try({
        try: () => buildSignedTx(prepared, yParity, r, s),
        catch: (cause) => toSignerError("signTransaction", cause)
      })
      return Transaction.serializeHex(fullTx) catch effect (e) => {
        throw toSignerError("signTransaction", e)
      }
    }

    effect function sendTx(tx: TransactionRequest): HashType!SignerError {
      const signedHex = try signTx(tx)
      return Effect.provideService(sendRawTransaction(signedHex), Transport, transport) catch effect (e) => {
        // If broadcast failed and we used NonceManager, reset cached nonce so next attempt resyncs!
        if (Option.isSome(nonceManagerOpt) && tx.nonce === undefined) {
          try nonceManagerOpt.value.reset(account.address)
        }
        throw toSignerError("sendTransaction", e)
      }
    }

    return Signer.of({
      address: account.address,

      effect signMessage(message: string | Uint8Array): SignatureType!SignerError {
        return account.signMessage(message) catch effect (e) => {
          throw toSignerError("signMessage", e)
        }
      },

      effect signTypedData(typedData: Eip712Ns.Eip712TypedDataInput): SignatureType!SignerError {
        return account.signTypedData(typedData) catch effect (e) => {
          throw toSignerError("signTypedData", e)
        }
      },

      prepareTransaction: prepareTx,
      signTransaction: signTx,
      sendTransaction: sendTx,

      effect sendTransactionAndWait(
        tx: TransactionRequest,
        waitOptions?: WaitForReceiptOptions
      ): { readonly hash: HashType; readonly receipt: RpcTransactionReceipt }!SignerError {
        const hash = try sendTx(tx)
        const receipt = Effect.provideService(
          waitForTransactionReceipt(hash, waitOptions),
          Transport,
          transport
        ) catch effect (e) => {
          throw toSignerError("sendTransactionAndWait", e)
        }
        return { hash, receipt }
      },

      effect prepareAuthorization(params: PrepareAuthorizationParams): SignedAuthorization!SignerError {
        const [chainId, nonce] = try.all [
          effect {
            if (params.chainId !== undefined) return params.chainId
            return Effect.provideService(getChainId(), Transport, transport) catch effect (e) => {
              throw toSignerError("prepareAuthorization", e)
            }
          },
          effect {
            if (params.nonce !== undefined) return params.nonce
            return Effect.provideService(getTransactionCount(fromHex, "pending"), Transport, transport) catch effect (e) => {
              throw toSignerError("prepareAuthorization", e)
            }
          }
        ]
        return account.signAuthorization({
          chainId,
          address: params.contractAddress,
          nonce
        }) catch effect (e) => {
          throw toSignerError("prepareAuthorization", e)
        }
      },

      effect deployContract(params: DeployContractParams): HashType!SignerError {
        const bytecodeHex = Hex.from(params.bytecode) catch effect (e) => {
          throw toSignerError("deployContract", e)
        }
        let deployData = bytecodeHex
        const ctor = params.abi.find((item) => item.type === "constructor")
        if (ctor !== undefined && ctor.inputs !== undefined && ctor.inputs.length > 0 && params.args !== undefined && params.args.length > 0) {
          const encodedArgs = Abi.encodeParameters(ctor.inputs, params.args) catch effect (e) => {
            throw toSignerError("deployContract", e)
          }
          deployData = `${bytecodeHex}${encodedArgs.slice(2)}` as HexType
        }
        return try sendTx({
          to: null,
          data: deployData,
          value: params.value,
          gasLimit: params.gasLimit,
          nonce: params.nonce
        })
      }
    })
  }
)

// One-line Signer layer from a private key (includes atomic NonceManager!).
export function SignerFromPrivateKey(privateKey: Uint8Array | HexType | `0x${string}`) {
  return Layer.provide(
    SignerLive,
    Layer.merge(LocalAccount(privateKey), NonceManagerLive)
  )
}

// One-line Signer layer from a BIP-39 mnemonic (includes atomic NonceManager!).
export function SignerFromMnemonic(
  mnemonic: string,
  options?: { readonly path?: string; readonly passphrase?: string }
) {
  return Layer.provide(
    SignerLive,
    Layer.merge(MnemonicAccount(mnemonic, options), NonceManagerLive)
  )
}
