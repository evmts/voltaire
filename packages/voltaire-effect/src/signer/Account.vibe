// Account service: LocalAccount, MnemonicAccount, and JsonRpcAccount (with EIP-7702 support).

import type { AddressType } from "@tevm/voltaire/Address"
import type { HexType } from "@tevm/voltaire/Hex"
import type { SignatureType } from "@tevm/voltaire/Signature"
import {
  CryptoLive,
  Eip712 as Eip712Ns,
  HdWalletService,
  KeccakService,
  Secp256k1Service,
  Signing,
} from "../crypto/index.vibe"
import { AccountError, errorMessage } from "../errors.vibe"
import * as Address from "../primitives/Address.vibe"
import * as Hash from "../primitives/Hash.vibe"
import * as Hex from "../primitives/Hex.vibe"
import * as Signature from "../primitives/Signature.vibe"
import * as Transaction from "../primitives/Transaction.vibe"
import { request, Transport } from "../transport/Transport.vibe"

export interface AccessListEntry {
  readonly address: Address.AddressInput
  readonly storageKeys: ReadonlyArray<`0x${string}`>
}

export interface SignedAuthorization {
  readonly chainId: bigint
  readonly address: `0x${string}`
  readonly nonce: bigint
  readonly yParity: number
  readonly r: HexType
  readonly s: HexType
}

export interface UnsignedAuthorization {
  readonly chainId: bigint
  readonly address: Address.AddressInput
  readonly nonce: bigint
}

export interface SignableTransaction {
  readonly type: 0 | 1 | 2 | 3 | 4
  readonly nonce: bigint
  readonly chainId: bigint
  readonly gasLimit: bigint
  readonly to: AddressType | null
  readonly value: bigint
  readonly data: Uint8Array
  readonly gasPrice?: bigint
  readonly maxFeePerGas?: bigint
  readonly maxPriorityFeePerGas?: bigint
  readonly maxFeePerBlobGas?: bigint
  readonly blobVersionedHashes?: ReadonlyArray<`0x${string}`>
  readonly accessList?: ReadonlyArray<AccessListEntry>
  readonly authorizationList?: ReadonlyArray<SignedAuthorization>
}

module native {
  import * as VoltaireTx from "@tevm/voltaire/Transaction"
  import * as VoltaireRlp from "@tevm/voltaire/Rlp"
  import { Address as VoltaireAddress } from "@tevm/voltaire/Address"
  import * as VoltaireHash from "@tevm/voltaire/Hash"
  import * as VoltaireHex from "@tevm/voltaire/Hex"
  import type { SignableTransaction, UnsignedAuthorization } from "./Account.vibe"

  function bigintToMinimalBytes(n: bigint): Uint8Array {
    if (n === 0n) return new Uint8Array(0)
    let hex = n.toString(16)
    if (hex.length % 2 === 1) hex = `0${hex}`
    return VoltaireHex.toBytes(`0x${hex}` as any)
  }

  export function buildTxForSigningHash(tx: SignableTransaction): VoltaireTx.Any {
    const empty32 = new Uint8Array(32)
    const accessList = (tx.accessList ?? []).map((entry) => ({
      address: typeof entry.address === "string" ? VoltaireAddress.fromHex(entry.address) : entry.address,
      storageKeys: entry.storageKeys.map((k) => VoltaireHash.fromHex(k)),
    }))

    switch (tx.type) {
      case 0:
        return {
          type: VoltaireTx.Type.Legacy,
          nonce: tx.nonce,
          gasPrice: tx.gasPrice ?? 0n,
          gasLimit: tx.gasLimit,
          to: tx.to,
          value: tx.value,
          data: tx.data,
          v: tx.chainId * 2n + 35n,
          r: empty32,
          s: empty32,
        }
      case 1:
        return {
          type: VoltaireTx.Type.EIP2930,
          chainId: tx.chainId,
          nonce: tx.nonce,
          gasPrice: tx.gasPrice ?? 0n,
          gasLimit: tx.gasLimit,
          to: tx.to,
          value: tx.value,
          data: tx.data,
          accessList,
          yParity: 0,
          r: empty32,
          s: empty32,
        }
      case 2:
        return {
          type: VoltaireTx.Type.EIP1559,
          chainId: tx.chainId,
          nonce: tx.nonce,
          maxPriorityFeePerGas: tx.maxPriorityFeePerGas ?? 0n,
          maxFeePerGas: tx.maxFeePerGas ?? 0n,
          gasLimit: tx.gasLimit,
          to: tx.to,
          value: tx.value,
          data: tx.data,
          accessList,
          yParity: 0,
          r: empty32,
          s: empty32,
        }
      case 3:
        if (!tx.to) throw new Error("EIP-4844 transactions require a 'to' address")
        return {
          type: VoltaireTx.Type.EIP4844,
          chainId: tx.chainId,
          nonce: tx.nonce,
          maxPriorityFeePerGas: tx.maxPriorityFeePerGas ?? 0n,
          maxFeePerGas: tx.maxFeePerGas ?? 0n,
          gasLimit: tx.gasLimit,
          to: tx.to,
          value: tx.value,
          data: tx.data,
          accessList,
          maxFeePerBlobGas: tx.maxFeePerBlobGas ?? 0n,
          blobVersionedHashes: (tx.blobVersionedHashes ?? []).map((h) => VoltaireHash.fromHex(h)),
          yParity: 0,
          r: empty32,
          s: empty32,
        }
      case 4:
        return {
          type: VoltaireTx.Type.EIP7702,
          chainId: tx.chainId,
          nonce: tx.nonce,
          maxPriorityFeePerGas: tx.maxPriorityFeePerGas ?? 0n,
          maxFeePerGas: tx.maxFeePerGas ?? 0n,
          gasLimit: tx.gasLimit,
          to: tx.to,
          value: tx.value,
          data: tx.data,
          accessList,
          authorizationList: (tx.authorizationList ?? []).map((a) => ({
            chainId: a.chainId,
            address: VoltaireAddress.fromHex(a.address),
            nonce: a.nonce,
            yParity: a.yParity,
            r: VoltaireHex.toBytes(a.r),
            s: VoltaireHex.toBytes(a.s),
          })),
          yParity: 0,
          r: empty32,
          s: empty32,
        }
    }
  }

  // EIP-7702 MAGIC (0x05) || rlp([chain_id, address, nonce])
  export function encodeEip7702AuthPayload(auth: UnsignedAuthorization): Uint8Array {
    const addrBytes = typeof auth.address === "string"
      ? VoltaireAddress.toBytes(VoltaireAddress.fromHex(auth.address))
      : VoltaireAddress.toBytes(auth.address)
    const rlpEncoded = VoltaireRlp.encode([
      bigintToMinimalBytes(auth.chainId),
      addrBytes,
      bigintToMinimalBytes(auth.nonce),
    ])
    const out = new Uint8Array(1 + rlpEncoded.length)
    out[0] = 0x05
    out.set(rlpEncoded, 1)
    return out
  }
}

import { buildTxForSigningHash, encodeEip7702AuthPayload } from native

export service Account {
  static readonly key = "voltaire-effect/signer/Account"
  readonly address: AddressType
  signMessage(message: string | Uint8Array): SignatureType!AccountError
  signTypedData(typedData: Eip712Ns.Eip712TypedDataInput): SignatureType!AccountError
  signTransaction(tx: SignableTransaction): SignatureType!AccountError
  signAuthorization(auth: UnsignedAuthorization): SignedAuthorization!AccountError
}

effect function buildLocalAccountFromKey(keyBytes: Uint8Array): Context.Service.Shape<typeof Account>!AccountError {
  if (keyBytes.length !== 32) {
    throw new AccountError({ action: "init", message: `Expected 32-byte private key, got ${keyBytes.length} bytes` })
  }
  const address = Address.fromPrivateKey(keyBytes) catch effect (e) => {
    throw new AccountError({ action: "init", message: e.message, cause: e })
  }

  return Account.of({
    address,
    effect signMessage(message: string | Uint8Array): SignatureType!AccountError {
      provide CryptoLive {
        const secpSig = Signing.signMessage(message, keyBytes) catch effect (e) => {
          throw new AccountError({ action: "signMessage", message: e.message, cause: e })
        }
        return Signature.fromSecp256k1(secpSig.r, secpSig.s, secpSig.v) catch effect (e) => {
          throw new AccountError({ action: "signMessage", message: e.message, cause: e })
        }
      }
    },

    effect signTypedData(typedData: Eip712Ns.Eip712TypedDataInput): SignatureType!AccountError {
      provide CryptoLive {
        const eipSig = (try Eip712Ns.Eip712).signTypedData(typedData, keyBytes) catch effect (e) => {
          throw new AccountError({ action: "signTypedData", message: e.message, cause: e })
        }
        return Signature.fromSecp256k1(eipSig.r, eipSig.s, eipSig.v) catch effect (e) => {
          throw new AccountError({ action: "signTypedData", message: e.message, cause: e })
        }
      }
    },

    effect signTransaction(tx: SignableTransaction): SignatureType!AccountError {
      provide CryptoLive {
        const placeholder = try Effect.try({
          try: () => buildTxForSigningHash(tx),
          catch: (cause) =>
            new AccountError({
              action: "signTransaction",
              message: `Invalid transaction: ${errorMessage(cause)}`,
              cause,
            }),
        })
        const signingHash = Transaction.getSigningHash(placeholder) catch effect (e) => {
          throw new AccountError({ action: "signTransaction", message: e.message, cause: e })
        }
        const secp = try Secp256k1Service
        const secpSig = secp.sign(signingHash, keyBytes) catch effect (e) => {
          throw new AccountError({ action: "signTransaction", message: e.message, cause: e })
        }
        return Signature.fromSecp256k1(secpSig.r, secpSig.s, secpSig.v) catch effect (e) => {
          throw new AccountError({ action: "signTransaction", message: e.message, cause: e })
        }
      }
    },

    effect signAuthorization(auth: UnsignedAuthorization): SignedAuthorization!AccountError {
      provide CryptoLive {
        const addrHex = typeof auth.address === "string"
          ? Address.toHex(
            Address.fromHex(auth.address) catch effect (e) => {
              throw new AccountError({ action: "signAuthorization", message: e.message, cause: e })
            },
          )
          : Address.toHex(auth.address)
        const payload = try Effect.try({
          try: () => encodeEip7702AuthPayload(auth),
          catch: (cause) =>
            new AccountError({
              action: "signAuthorization",
              message: `Failed encoding EIP-7702 authorization: ${errorMessage(cause)}`,
              cause,
            }),
        })
        const keccak = try KeccakService
        const digest = keccak.hash(payload) catch effect (e) => {
          throw new AccountError({ action: "signAuthorization", message: e.message, cause: e })
        }
        const secp = try Secp256k1Service
        const sig = secp.sign(digest, keyBytes) catch effect (e) => {
          throw new AccountError({ action: "signAuthorization", message: e.message, cause: e })
        }
        const rHex = Hex.fromBytes(sig.r) catch effect (e) => {
          throw new AccountError({ action: "signAuthorization", message: e.message, cause: e })
        }
        const sHex = Hex.fromBytes(sig.s) catch effect (e) => {
          throw new AccountError({ action: "signAuthorization", message: e.message, cause: e })
        }
        const yParity = sig.v === 27 || sig.v === 28 ? sig.v - 27 : sig.v % 2
        return {
          chainId: auth.chainId,
          address: addrHex,
          nonce: auth.nonce,
          yParity,
          r: rHex,
          s: sHex,
        }
      }
    },
  })
}

export function LocalAccount(privateKey: Uint8Array | HexType | `0x${string}`): Layer.Layer<Account, AccountError> {
  return Layer.effect(
    Account,
    effect {
      const keyBytes = typeof privateKey === "string"
        ? Hex.toBytes(privateKey) catch effect (e) => {
          throw new AccountError({ action: "init", message: `Invalid private key hex: ${e.message}`, cause: e })
        }
        : privateKey
      return try buildLocalAccountFromKey(keyBytes)
    },
  )
}

export function MnemonicAccount(
  mnemonic: string,
  options?: { readonly path?: string; readonly passphrase?: string },
): Layer.Layer<Account, AccountError> {
  return Layer.effect(
    Account,
    effect {
      provide CryptoLive {
        const hd = try HdWalletService
        const keyBytes = hd.deriveFromMnemonic(mnemonic, options?.path, options?.passphrase) catch effect (e) => {
          throw new AccountError({ action: "mnemonic", message: e.message, cause: e })
        }
        return try buildLocalAccountFromKey(keyBytes)
      }
    },
  )
}

export function JsonRpcAccount(addressInput: Address.AddressInput): Layer.Layer<Account, AccountError, Transport> {
  return Layer.effect(
    Account,
    effect {
      const transport = try Transport
      const address = typeof addressInput === "string"
        ? Address.fromHex(addressInput) catch effect (e) => {
          throw new AccountError({ action: "init", message: e.message, cause: e })
        }
        : addressInput
      const addrHex = Address.toHex(address)

      return Account.of({
        address,
        effect signMessage(message: string | Uint8Array): SignatureType!AccountError {
          const msgHex = typeof message === "string"
            ? Hex.fromString(message) catch effect (e) => {
              throw new AccountError({ action: "signMessage", message: e.message, cause: e })
            }
            : Hex.fromBytes(message) catch effect (e) => {
              throw new AccountError({ action: "signMessage", message: e.message, cause: e })
            }
          const rawSig = Effect.provideService(
            request<string>("personal_sign", [msgHex, addrHex]),
            Transport,
            transport,
          ) catch effect (e) => {
            throw new AccountError({ action: "signMessage", message: e.message, cause: e })
          }
          return Signature.fromHex(rawSig) catch effect (e) => {
            throw new AccountError({ action: "signMessage", message: e.message, cause: e })
          }
        },

        effect signTypedData(typedData: Eip712Ns.Eip712TypedDataInput): SignatureType!AccountError {
          const payload = try Effect.try({
            try: () => JSON.stringify(typedData, (_k, v) => (typeof v === "bigint" ? v.toString() : v)),
            catch: (cause) =>
              new AccountError({
                action: "signTypedData",
                message: `Failed serializing typed data: ${errorMessage(cause)}`,
                cause,
              }),
          })
          const rawSig = Effect.provideService(
            request<string>("eth_signTypedData_v4", [addrHex, payload]),
            Transport,
            transport,
          ) catch effect (e) => {
            throw new AccountError({ action: "signTypedData", message: e.message, cause: e })
          }
          return Signature.fromHex(rawSig) catch effect (e) => {
            throw new AccountError({ action: "signTypedData", message: e.message, cause: e })
          }
        },

        effect signTransaction(_tx: SignableTransaction): SignatureType!AccountError {
          throw new AccountError({
            action: "signTransaction",
            message: "JsonRpcAccount does not support offline signTransaction; use LocalAccount or eth_sendTransaction",
          })
        },

        effect signAuthorization(_auth: UnsignedAuthorization): SignedAuthorization!AccountError {
          throw new AccountError({
            action: "signAuthorization",
            message: "JsonRpcAccount does not support offline EIP-7702 signAuthorization; use LocalAccount",
          })
        },
      })
    },
  )
}
